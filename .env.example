# URL pública de la web (canonical, sitemap, Open Graph).
SITE_URL=https://vsl.rehabilitywod.com

# ID del Meta Pixel. Si no se define, se usa el de src/config.ts.
PUBLIC_META_PIXEL_ID=1433154668778788

# URL de la aplicación web de Apps Script (Implementar > Aplicación web).
GOOGLE_SCRIPT_URL=

# Cadena larga y aleatoria. La misma que la propiedad LEAD_SECRET del script.
LEAD_SECRET=

# 1 = no envía nada a Google: registra el lead en la consola (teléfono enmascarado).
LEAD_MOCK=0

# Opcional. Token de la Conversions API de Meta. Vacío = desactivada.
META_CAPI_TOKEN=
