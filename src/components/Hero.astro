---
/**
 * Sección 1: hero a pantalla completa con foto de box (vertical en móvil y tablet, horizontal
 * desde 1024 px), velo, grano y la cinta de stats pegada abajo.
 * Sin animaciones de entrada: titular, subtítulo y botones se ven en la primera pintura.
 *
 * Mensaje según el anuncio: el script en línea del <head> (src/lib/ad-script.ts) marca
 * <html data-ad="..."> y aquí el CSS muestra el antetítulo y el subtítulo de ese anuncio
 * (src/data/ad-variants.ts). Sin anuncio conocido se ve el subtítulo de siempre y sin antetítulo.
 *
 * Bajo los botones: "+120 atletas recuperados" (también en la cinta) y "¿Qué te duele?", que
 * empieza el formulario con esa zona marcada (form.ts, evento rw:zona).
 */
import CtaButton from './CtaButton.astro';
import SplitWords from './SplitWords.astro';
import StatsTicker from './StatsTicker.astro';
import ZoneIcon from './ZoneIcon.astro';
import { heroSources, HERO_MEDIA } from '../lib/hero';
import { AD_VARIANTS } from '../data/ad-variants';

const { mobile, desktop } = await heroSources();

// En móvil caben 5: las 4 zonas más comunes y "Otra". Desde 768 px se ven todas.
const zones = [
  { zona: 'Hombro', label: 'Hombro' },
  { zona: 'Rodilla', label: 'Rodilla' },
  { zona: 'Espalda / lumbar', label: 'Espalda' },
  { zona: 'Codo', label: 'Codo' },
  { zona: 'Muñeca', label: 'Muñeca', extra: true },
  { zona: 'Cadera', label: 'Cadera', extra: true },
  { zona: 'Tobillo / pie', label: 'Tobillo', extra: true },
  { zona: 'Otro', label: 'Otra' },
];
---

<section id="inicio" class="hero" data-theme="dark" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <picture>
      <source media={HERO_MEDIA.desktop} type="image/avif" srcset={desktop.avif} sizes="100vw" />
      <source media={HERO_MEDIA.desktop} type="image/webp" srcset={desktop.webp} sizes="100vw" />
      <source type="image/avif" srcset={mobile.avif} sizes="100vw" />
      <source type="image/webp" srcset={mobile.webp} sizes="100vw" />
      <img
        src={mobile.fallback}
        width={mobile.width}
        height={mobile.height}
        alt=""
        fetchpriority="high"
        loading="eager"
        class="hero-img"
      />
    </picture>
    <div class="hero-veil"></div>
    <div class="hero-grain tex-grain"></div>
  </div>

  <div class="container-x hero-content">
    {AD_VARIANTS.map((v) => (
      <p class="eyebrow hero-eyebrow" data-ad-variant={v.key}>
        {v.eyebrow}
      </p>
    ))}
    <SplitWords
      as="h1"
      id="hero-title"
      class="h1-display hero-title"
      reveal={false}
      parts={[
        'Recupérate',
        { br: 'always' },
        { text: 'sin dejar', accent: true },
        { br: 'mobile' },
        { text: 'de entrenar.', accent: true },
      ]}
    />
    <p class="hero-sub hero-sub-default">
      Plan a medida, seguimiento diario y ajustes cada semana.
      <br />
      Estés donde estés.
    </p>
    {AD_VARIANTS.map((v) => (
      <p class="hero-sub" data-ad-variant={v.key}>
        {v.sub}
      </p>
    ))}
    <div class="hero-ctas">
      <CtaButton location="hero" class="hero-cta" data-hero-cta="">
        Quiero valorar mi caso
      </CtaButton>
      <CtaButton href="#video" location="hero_video" variant="ghost" icon="play" class="hero-cta">
        Ver el vídeo
      </CtaButton>
    </div>
    <p class="hero-proof">
      <span class="hero-proof-strong">+120</span> atletas recuperados
    </p>
    <div class="hero-zones" role="group" aria-labelledby="hero-zones-title" data-hero-zones>
      <p class="hero-zones-title" id="hero-zones-title">
        ¿Qué te duele?
      </p>
      <div class="hero-zones-list">
        {zones.map(({ zona, label, extra }) => (
          <button
            type="button"
            class:list={['hero-zone', { 'hero-zone-extra': extra }]}
            data-zona={zona}
            aria-label={`${zona === 'Otro' ? 'Otra zona' : zona}: empezar la valoración`}
          >
            <ZoneIcon zona={zona} />
            <span class="hero-zone-label">{label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <StatsTicker />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: var(--void);
    color: var(--ink-on-dark);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .hero-media picture {
    display: block;
    height: 100%;
  }

  .hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Vertical: el rig y la barra quedan arriba, el suelo oscuro abajo para el texto. */
    object-position: 38% 30%;
    filter: contrast(1.03) saturate(0.95);
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.35) 0%,
      rgba(10, 10, 10, 0.05) 28%,
      rgba(10, 10, 10, 0.55) 55%,
      rgba(10, 10, 10, 0.97) 88%
    );
  }

  /* Móvil: con el antetítulo, "+120" y "¿Qué te duele?" el texto llega a la zona clara de la foto
     (ventanas). Velo más denso para mantener el contraste AA en el peor punto. */
  @media (width < 768px) {
    .hero-veil {
      background: linear-gradient(
        180deg,
        rgba(10, 10, 10, 0.62) 0%,
        rgba(10, 10, 10, 0.6) 30%,
        rgba(10, 10, 10, 0.72) 55%,
        rgba(10, 10, 10, 0.97) 88%
      );
    }
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    --grain: 0.05;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + env(safe-area-inset-top) + 32px);
    padding-bottom: 40px;
    text-align: center;
  }

  .hero-title {
    max-width: 11em;
  }

  .hero-sub {
    max-width: 22.5rem;
    margin-top: 20px;
    font-size: 1.125rem;
    line-height: 1.45;
    color: #e2e2de;
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 360px;
    margin-top: 28px;
  }

  .hero-ctas :global(.hero-cta) {
    width: 100%;
  }

  /* Variantes por anuncio: ocultas salvo la de <html data-ad>. */
  [data-ad-variant] {
    display: none;
  }

  .hero-eyebrow {
    max-width: 22rem;
    margin-bottom: 10px;
    color: var(--brand-bright);
  }

  /* Con antetítulo, algo menos de aire arriba para que los botones sigan en la primera pantalla. */
  @media (width < 768px) and (orientation: portrait) {
    :global(html[data-ad]) .hero-content {
      padding-top: calc(var(--header-h) + env(safe-area-inset-top) + 18px);
    }
  }

  :global(html[data-ad='mofu1']) [data-ad-variant='mofu1'],
  :global(html[data-ad='mofu2']) [data-ad-variant='mofu2'],
  :global(html[data-ad='mofu3']) [data-ad-variant='mofu3'],
  :global(html[data-ad='bofu1']) [data-ad-variant='bofu1'],
  :global(html[data-ad='bofu2']) [data-ad-variant='bofu2'] {
    display: block;
  }

  :global(html[data-ad]) .hero-sub-default {
    display: none;
  }

  .hero-proof {
    margin-top: 12px;
    font-size: 0.875rem;
    line-height: 1.3;
    color: #e2e2de;
  }

  .hero-proof-strong {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--brand-bright);
  }

  /* "¿Qué te duele?": fila compacta con las figuras del formulario. */
  .hero-zones {
    width: 100%;
    max-width: 360px;
    margin-top: 12px;
  }

  .hero-zones-title {
    margin-bottom: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #ffffff;
  }

  .hero-zones-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }

  .hero-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 52px;
    padding: 5px 2px 4px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    background: rgba(10, 10, 10, 0.45);
    color: #ffffff;
    font: inherit;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .hero-zone:hover {
    border-color: var(--brand-bright);
    background: rgba(5, 148, 103, 0.18);
  }

  .hero-zone:active {
    transform: scale(0.97);
  }

  .hero-zone :global(.zone-icon) {
    width: 17px;
    height: 27px;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero-zone :global(.zone-dot) {
    fill: var(--brand-bright);
  }

  .hero-zone :global(.zone-halo) {
    fill: var(--brand-bright);
    opacity: 0.3;
  }

  .hero-zone :global(.zone-spine) {
    stroke: #121212;
  }

  .hero-zone :global(.zone-q) {
    stroke: var(--void);
  }

  .hero-zone-label {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.1;
  }

  /* En móvil solo las 4 zonas más comunes y "Otra". */
  .hero-zone.hero-zone-extra {
    display: none;
  }

  /* Tablet: la misma foto vertical, algo más centrada, y velo uniforme con el texto al centro. */
  @media (width >= 768px) {
    .hero-img {
      object-position: 42% 35%;
    }

    .hero-veil {
      background:
        radial-gradient(60% 50% at 50% 50%, rgba(10, 10, 10, 0.4), rgba(10, 10, 10, 0) 100%),
        linear-gradient(
          180deg,
          rgba(10, 10, 10, 0.62) 0%,
          rgba(10, 10, 10, 0.6) 40%,
          rgba(10, 10, 10, 0.7) 70%,
          rgba(10, 10, 10, 0.95) 100%
        );
    }

    .hero-content {
      justify-content: center;
      padding-top: calc(var(--header-h) + 48px);
      padding-bottom: 64px;
    }

    .hero-title {
      max-width: none;
    }

    .hero-sub {
      max-width: 34rem;
      margin-top: 28px;
      font-size: 1.1875rem;
    }

    .hero-ctas {
      flex-direction: row;
      justify-content: center;
      width: auto;
      max-width: none;
      margin-top: 36px;
    }

    .hero-ctas :global(.hero-cta) {
      width: auto;
    }

    .hero-eyebrow {
      max-width: none;
    }

    .hero-proof {
      margin-top: 18px;
    }

    .hero-zones {
      max-width: 640px;
      margin-top: 18px;
    }

    .hero-zones-list {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .hero-zone.hero-zone-extra {
      display: flex;
    }
  }

  /* Escritorio: foto horizontal y velo más uniforme, más oscuro abajo. */
  @media (width >= 1024px) {
    .hero-img {
      object-position: 50% 50%;
    }

    /* Velo más uniforme, algo más denso detrás del texto (contraste AA en el peor punto). */
    .hero-veil {
      background:
        radial-gradient(52% 46% at 50% 50%, rgba(10, 10, 10, 0.42), rgba(10, 10, 10, 0) 100%),
        linear-gradient(
          180deg,
          rgba(10, 10, 10, 0.62) 0%,
          rgba(10, 10, 10, 0.56) 40%,
          rgba(10, 10, 10, 0.66) 70%,
          rgba(10, 10, 10, 0.95) 100%
        );
    }
  }

  /* Móvil apaisado: sin depender de 100svh. */
  @media (height < 500px) and (orientation: landscape) {
    .hero {
      min-height: auto;
    }

    .hero-content {
      padding-top: calc(var(--header-h) + 32px);
      padding-bottom: 40px;
    }
  }
</style>
