---
/**
 * Sección 1: hero a pantalla completa con foto de box (vertical en móvil y tablet, horizontal
 * desde 1024 px), velo, grano y la cinta de stats pegada abajo. Sin eyebrow.
 * El H1 hace word-up al cargar (CSS, sin JS); si hay intro, arranca cuando se abre el panel.
 */
import CtaButton from './CtaButton.astro';
import SplitWords from './SplitWords.astro';
import StatsTicker from './StatsTicker.astro';
import { heroSources, HERO_MEDIA } from '../lib/hero';

const { mobile, desktop } = await heroSources();
---

<section id="inicio" class="hero" data-theme="dark" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <picture>
      <source media={HERO_MEDIA.desktop} type="image/avif" srcset={desktop.avif} sizes="100vw" />
      <source media={HERO_MEDIA.desktop} type="image/webp" srcset={desktop.webp} sizes="100vw" />
      <source type="image/avif" srcset={mobile.avif} sizes="100vw" />
      <source type="image/webp" srcset={mobile.webp} sizes="100vw" />
      <img
        src={mobile.fallback}
        width={mobile.width}
        height={mobile.height}
        alt=""
        fetchpriority="high"
        loading="eager"
        class="hero-img"
      />
    </picture>
    <div class="hero-veil"></div>
    <div class="hero-grain tex-grain"></div>
  </div>

  <div class="container-x hero-content">
    <SplitWords
      as="h1"
      id="hero-title"
      class="h1-display hero-title"
      reveal={false}
      parts={[
        'Recupérate',
        { br: 'always' },
        { text: 'sin dejar', accent: true },
        { br: 'mobile' },
        { text: 'de entrenar.', accent: true },
      ]}
    />
    <p class="hero-sub">
      Plan a medida, seguimiento diario y ajustes cada semana. Estés donde estés.
    </p>
    <div class="hero-ctas">
      <CtaButton location="hero" class="hero-cta" data-hero-cta="">
        Quiero valorar mi caso
      </CtaButton>
      <CtaButton href="#video" location="hero_video" variant="ghost" icon="play" class="hero-cta">
        Ver el vídeo
      </CtaButton>
    </div>
  </div>

  <StatsTicker />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: var(--void);
    color: var(--ink-on-dark);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .hero-media picture {
    display: block;
    height: 100%;
  }

  .hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Vertical: el rig y la barra quedan arriba, el suelo oscuro abajo para el texto. */
    object-position: 38% 30%;
    filter: contrast(1.03) saturate(0.95);
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.35) 0%,
      rgba(10, 10, 10, 0.05) 28%,
      rgba(10, 10, 10, 0.55) 55%,
      rgba(10, 10, 10, 0.97) 88%
    );
  }

  /* Pantallas bajas: el texto sube hacia la zona clara de la foto (ventanas). Velo más denso
     para mantener el contraste AA en el peor punto. */
  @media (width < 768px) and (height < 800px) {
    .hero-veil {
      background: linear-gradient(
        180deg,
        rgba(10, 10, 10, 0.62) 0%,
        rgba(10, 10, 10, 0.6) 30%,
        rgba(10, 10, 10, 0.72) 55%,
        rgba(10, 10, 10, 0.97) 88%
      );
    }
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    --grain: 0.05;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + env(safe-area-inset-top) + 32px);
    padding-bottom: 40px;
    text-align: center;
  }

  .hero-title {
    max-width: 11em;
  }

  .hero-title :global(.w > span) {
    animation: word-up 0.9s var(--ease) both;
    animation-delay: calc(0.1s + var(--i) * 70ms);
  }

  :global(html[data-intro='play']) .hero-title :global(.w > span) {
    animation-delay: calc(0.65s + var(--i) * 70ms);
  }

  .hero-sub {
    max-width: 22.5rem;
    margin-top: 20px;
    font-size: 1.125rem;
    line-height: 1.45;
    color: #e2e2de;
    animation: fade-up 0.8s var(--ease) 0.35s both;
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 360px;
    margin-top: 28px;
    animation: fade-up 0.8s var(--ease) 0.45s both;
  }

  :global(html[data-intro='play']) .hero-sub {
    animation-delay: 1s;
  }

  :global(html[data-intro='play']) .hero-ctas {
    animation-delay: 1.1s;
  }

  .hero-ctas :global(.hero-cta) {
    width: 100%;
  }

  .hero :global(.ticker) {
    animation: fade-up 0.8s var(--ease) 0.55s both;
  }

  :global(html[data-intro='play']) .hero :global(.ticker) {
    animation-delay: 1.15s;
  }

  /* Tablet: la misma foto vertical, algo más centrada, y velo uniforme con el texto al centro. */
  @media (width >= 768px) {
    .hero-img {
      object-position: 42% 35%;
    }

    .hero-veil {
      background:
        radial-gradient(60% 50% at 50% 50%, rgba(10, 10, 10, 0.4), rgba(10, 10, 10, 0) 100%),
        linear-gradient(
          180deg,
          rgba(10, 10, 10, 0.62) 0%,
          rgba(10, 10, 10, 0.6) 40%,
          rgba(10, 10, 10, 0.7) 70%,
          rgba(10, 10, 10, 0.95) 100%
        );
    }

    .hero-content {
      justify-content: center;
      padding-top: calc(var(--header-h) + 48px);
      padding-bottom: 64px;
    }

    .hero-title {
      max-width: none;
    }

    .hero-sub {
      max-width: 34rem;
      margin-top: 28px;
      font-size: 1.1875rem;
    }

    .hero-ctas {
      flex-direction: row;
      justify-content: center;
      width: auto;
      max-width: none;
      margin-top: 36px;
    }

    .hero-ctas :global(.hero-cta) {
      width: auto;
    }
  }

  /* Escritorio: foto horizontal y velo más uniforme, más oscuro abajo. */
  @media (width >= 1024px) {
    .hero-img {
      object-position: 50% 50%;
    }

    /* Velo más uniforme, algo más denso detrás del texto (contraste AA en el peor punto). */
    .hero-veil {
      background:
        radial-gradient(52% 46% at 50% 50%, rgba(10, 10, 10, 0.42), rgba(10, 10, 10, 0) 100%),
        linear-gradient(
          180deg,
          rgba(10, 10, 10, 0.62) 0%,
          rgba(10, 10, 10, 0.56) 40%,
          rgba(10, 10, 10, 0.66) 70%,
          rgba(10, 10, 10, 0.95) 100%
        );
    }
  }

  /* Móvil apaisado: sin depender de 100svh. */
  @media (height < 500px) and (orientation: landscape) {
    .hero {
      min-height: auto;
    }

    .hero-content {
      padding-top: calc(var(--header-h) + 32px);
      padding-bottom: 40px;
    }
  }
</style>
