---
/**
 * 5B: quién está detrás. La foto es SIEMPRE de Gerard (nunca stock) y es lo principal del
 * bloque: va grande justo después del titular.
 *
 * La foto (src/assets/photos/gerard.jpg) es un recorte 4:5 de la foto que envió el cliente
 * (1717x2146); el srcset nunca pasa del tamaño natural.
 *
 * Móvil: titular, foto a todo el ancho, 4 datos (2x2) y CTA.
 * Escritorio: titular arriba, foto a la izquierda y los 4 datos en columna a la derecha, y el
 * CTA centrado debajo.
 */
import { getImage } from 'astro:assets';
import Users from '@lucide/astro/icons/users';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Dumbbell from '@lucide/astro/icons/dumbbell';
import Target from '@lucide/astro/icons/target';
import CtaButton from './CtaButton.astro';
import SplitWords from './SplitWords.astro';
import gerard from '../assets/photos/gerard.jpg';
import { QUALITY } from '../lib/images';

const widths = [...new Set([400, 576, 800, 1080, 1440].map((w) => Math.min(w, gerard.width)))];
const [avif, webp] = await Promise.all([
  getImage({ src: gerard, widths, format: 'avif', quality: QUALITY.avif }),
  getImage({ src: gerard, widths, format: 'webp', quality: QUALITY.webp }),
]);
const sizes = '(min-width: 1024px) 460px, (min-width: 768px) 440px, calc(100vw - 40px)';
const alt =
  'Gerard Barrantes, fisioterapeuta y fundador de RehabilityWOD, en una competición de CrossFit';

const facts = [
  { Icon: Users, text: '+120 atletas recuperados' },
  { Icon: GraduationCap, text: 'Fisioterapeuta titulado' },
  { Icon: Dumbbell, text: 'Atleta desde 2017' },
  { Icon: Target, text: 'Especialista en CrossFit' },
];
---

<div class="about section-y" data-theme="dark">
  <div class="container-x">
    <div class="about-head">
      <p class="eyebrow reveal" data-reveal>
        Quién está detrás
      </p>
      <SplitWords
        as="p"
        class="about-phrase"
        start={1}
        parts={['Conozco el box', { br: 'always' }, { text: 'por dentro.', accent: true }]}
      />
    </div>

    <div class="about-grid">
      <figure class="about-photo reveal-clip" data-reveal>
        <picture>
          <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
          <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
          <img
            src={webp.src}
            width={gerard.width}
            height={gerard.height}
            alt={alt}
            loading="lazy"
            decoding="async"
            class="about-img"
          />
        </picture>
        <figcaption class="about-caption">
          <span class="about-name">Gerard Barrantes</span>
          <span class="about-role">Fundador de RehabilityWOD</span>
        </figcaption>
      </figure>

      <div class="about-copy">
        <ul class="about-facts" role="list">
          {facts.map(({ Icon, text }, i) => (
            <li class="about-fact reveal" data-reveal style={`--i:${i + 1}`}>
              <span class="icon-ring" aria-hidden="true">
                <Icon size={20} stroke-width={1.75} />
              </span>
              <span class="about-fact-text">{text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="section-cta reveal" data-reveal>
      <CtaButton location="about">Quiero valorar mi caso</CtaButton>
    </div>
  </div>
</div>

<style>
  .about {
    background: var(--void);
    color: var(--ink-on-dark);
    text-align: center;
  }

  .about-head {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-phrase {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 12.5vw, 3.5rem);
    line-height: 0.9;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--ink-on-dark);
  }

  .about-grid {
    margin-top: var(--title-gap);
  }

  /* Foto grande de Gerard (4:5) con su nombre sobre un degradado. */
  .about-photo {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--hair-on-dark);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.9);
  }

  .about-photo picture,
  .about-img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .about-img {
    object-fit: cover;
    object-position: 50% 30%;
  }

  .about-caption {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 2px;
    padding: 64px 20px 18px;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0) 0%, rgba(10, 10, 10, 0.86) 100%);
    text-align: left;
  }

  .about-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .about-role {
    font-size: 0.9375rem;
    color: #e2e2de;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 32px;
  }

  /* 4 datos con el mismo estilo: 2x2 en móvil y tablet. */
  .about-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 30rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-fact {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 10px;
    padding: 18px 12px;
    border: 1px solid var(--hair-on-dark);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    transition:
      border-color 0.4s var(--ease),
      transform 0.4s var(--ease),
      opacity 0.8s var(--ease);
  }

  .about-fact :global(.icon-ring) {
    width: 40px;
    height: 40px;
  }

  @media (hover: hover) {
    .about-fact:hover {
      border-color: rgba(52, 211, 153, 0.45);
      transform: translateY(-4px);
    }
  }

  @media (width >= 768px) {
    .about-phrase {
      margin-top: 20px;
      font-size: clamp(3.75rem, 1.5rem + 4vw, 6rem);
    }

    .about-photo {
      max-width: 440px;
    }

    .about-copy {
      margin-top: 40px;
    }
  }

  /* Escritorio: foto a la izquierda y el resto a la derecha. */
  @media (width >= 1024px) {
    .about-grid {
      display: grid;
      grid-template-columns: 460px minmax(0, 1fr);
      column-gap: 72px;
      align-items: center;
      max-width: 1080px;
      margin-inline: auto;
    }

    .about-photo {
      max-width: none;
    }

    .about-copy {
      width: 100%;
      align-items: flex-start;
      margin-top: 0;
      text-align: left;
    }

    /* Los 4 datos en columna junto a la foto. */
    .about-facts {
      grid-template-columns: 1fr;
      gap: 14px;
      max-width: 440px;
    }

    .about-fact {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      align-items: center;
      gap: 16px;
      padding: 22px 24px;
      font-size: 1.125rem;
    }

    .about-fact :global(.icon-ring) {
      width: 48px;
      height: 48px;
    }
  }
</style>
