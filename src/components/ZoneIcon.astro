---
/**
 * Figura articulada (cabeza, torso, brazos, antebrazos, manos, muslos, piernas y pies) con la
 * zona que duele resaltada en verde. "Espalda / lumbar" se ve de espaldas (con la columna) y
 * "Otro" lleva un signo de interrogación. Los colores van en LeadForm.astro.
 */
interface Props {
  zona: string;
}

const { zona } = Astro.props;

const spots: Record<string, [number, number]> = {
  Hombro: [28.3, 15.8],
  Codo: [30.8, 27],
  Muñeca: [32.4, 37.2],
  Cadera: [24.2, 36],
  Rodilla: [24.25, 48.6],
  'Tobillo / pie': [24.9, 60.2],
};
const spot = spots[zona];
const isBack = zona === 'Espalda / lumbar';
const isOther = !spot && !isBack;
---

<svg
  class="zone-icon"
  viewBox="0 0 40 64"
  width="30"
  height="48"
  aria-hidden="true"
  focusable="false"
>
  <g class="zone-body" fill="currentColor" stroke="currentColor" stroke-linecap="round">
    <circle cx="20" cy="6.2" r="4.4" stroke="none"></circle>
    <rect x="18.2" y="9.8" width="3.6" height="4" rx="1.2" stroke="none"></rect>
    <path
      stroke="none"
      d="M12.6 14.6C14.2 13.3 16.6 12.9 20 12.9s5.8.4 7.4 1.7c.8.7.9 2 .6 3.6l-1.4 8.4c-.3 2 .1 4 .7 6.4l.3 1.6c-2.3 1.5-4.9 2.1-7.6 2.1s-5.3-.6-7.6-2.1l.3-1.6c.6-2.4 1-4.4.7-6.4L12 18.2c-.3-1.6-.2-2.9.6-3.6Z"
    ></path>
    <path fill="none" stroke-width="3.4" d="M28.7 16.6l1.9 9.2M11.3 16.6l-1.9 9.2"></path>
    <path fill="none" stroke-width="3" d="M31 28.4l1.3 7.6M9 28.4l-1.3 7.6"></path>
    <circle cx="32.8" cy="38.9" r="1.9" stroke="none"></circle>
    <circle cx="7.2" cy="38.9" r="1.9" stroke="none"></circle>
    <path fill="none" stroke-width="4.2" d="M23.2 38.2l.9 8.8M16.8 38.2l-.9 8.8"></path>
    <path fill="none" stroke-width="3.4" d="M24.3 50.2l.4 8.2M15.7 50.2l-.4 8.2"></path>
    <path fill="none" stroke-width="2.6" d="M25 61.4h2.8M15 61.4h-2.8"></path>
  </g>
  {isBack && (
    <>
      <path
        class="zone-spine"
        fill="none"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-dasharray="1.2 1.6"
        d="M20 14.6V34"
      ></path>
      <ellipse class="zone-halo" cx="20" cy="30.4" rx="7" ry="4.4"></ellipse>
      <ellipse class="zone-dot" cx="20" cy="30.4" rx="3.8" ry="2.3"></ellipse>
    </>
  )}
  {spot && (
    <>
      <circle class="zone-halo" cx={spot[0]} cy={spot[1]} r="5.4"></circle>
      <circle class="zone-dot" cx={spot[0]} cy={spot[1]} r="2.7"></circle>
    </>
  )}
  {isOther && (
    <>
      <circle class="zone-dot" cx="31" cy="8.4" r="6.6"></circle>
      <path
        class="zone-q"
        fill="none"
        stroke-width="1.7"
        stroke-linecap="round"
        d="M29 7a2 2 0 1 1 3 1.75c-.62.36-1 .82-1 1.55M31 12.1h.01"
      ></path>
    </>
  )}
</svg>
