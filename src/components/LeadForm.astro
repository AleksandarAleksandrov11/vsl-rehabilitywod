---
/**
 * Formulario de valoración: un único <form>, cada paso es un <fieldset>.
 * Sin JS se ven todos los campos a la vez y el POST va a /api/lead (que redirige a /gracias).
 * Con JS (src/scripts/form.ts) pasa a una pregunta por pantalla. Solo cambia lo visual:
 * ids, nombres y data-atributos son los mismos que usa form.ts.
 */
import CircleAlert from '@lucide/astro/icons/circle-alert';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ZoneIcon from './ZoneIcon.astro';
import { ZONAS, LIMITS } from '../lib/lead';

// Orden visual de arriba abajo del cuerpo (los valores no cambian). Todas las opciones miden
// lo mismo: 2 columnas x 4 filas en móvil y 4 x 2 desde 768 px.
const ORDER = [
  'Hombro',
  'Codo',
  'Muñeca',
  'Espalda / lumbar',
  'Cadera',
  'Rodilla',
  'Tobillo / pie',
  'Otro',
];
const zonas = [...ZONAS].sort((a, b) => ORDER.indexOf(a) - ORDER.indexOf(b));
---

<div class="form-card" data-form-root data-theme="dark">
  <div class="progress" data-progress hidden>
    <p class="progress-text eyebrow" data-progress-text aria-hidden="true">
      Paso 1 de 4
    </p>
    <div class="progress-track" aria-hidden="true">
      <div class="progress-bar" data-progress-bar></div>
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
  <p class="form-error form-notice" data-form-notice role="alert" hidden></p>

  <form id="lead-form" class="lead-form" action="/api/lead" method="post" accept-charset="utf-8">
    <!-- Antispam: honeypot oculto con CSS (no display:none). -->
    <div class="hp" aria-hidden="true">
      <label for="website">Tu web</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Paso 1 -->
    <fieldset class="step" data-step="1">
      <legend class="step-legend">
        <h3 class="step-title" id="s1-title" tabindex="-1">
          ¿Qué te duele?
        </h3>
      </legend>
      <div
        class="chips"
        role="radiogroup"
        aria-labelledby="s1-title"
        aria-required="true"
        aria-describedby="err-zona"
        data-chips
      >
        {zonas.map((zona, i) => (
          <label class="chip">
            <input
              type="radio"
              name="zona"
              value={zona}
              required={i === 0 ? true : undefined}
              class="chip-input"
            />
            <ZoneIcon zona={zona} />
            {/* "Espalda /" y "Tobillo /" en la primera línea cuando el texto se parte. */}
            <span class="chip-text">{zona.replace(' / ', '\u00a0/ ')}</span>
            <span class="chip-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" focusable="false">
                <path
                  d="m5 12.5 4.5 4.5L19 7.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </span>
          </label>
        ))}
      </div>
      <p class="field-error" id="err-zona" data-error="zona" hidden>
        <CircleAlert size={16} stroke-width={1.75} aria-hidden="true" />
        <span></span>
      </p>
    </fieldset>

    <!-- Paso 2 -->
    <fieldset class="step" data-step="2">
      <legend class="step-legend">
        <h3 class="step-title" id="s2-title" tabindex="-1" data-detalle-title>
          Cuéntame un poco más.
        </h3>
      </legend>
      <label class="sr-only" for="detalle">
        Tu caso <span data-optional>(opcional)</span>
      </label>
      <textarea
        id="detalle"
        name="detalle"
        class="field textarea"
        rows="3"
        maxlength={LIMITS.detalleMax}
        placeholder="Ej.: me duele el hombro en los overhead desde hace 6 meses."
        aria-describedby="detalle-count err-detalle"
        enterkeyhint="next"
      ></textarea>
      <div class="field-meta">
        <p class="field-error" id="err-detalle" data-error="detalle" hidden>
          <CircleAlert size={16} stroke-width={1.75} aria-hidden="true" />
          <span></span>
        </p>
        <p class="field-count tabular" id="detalle-count" data-count>
          <span data-count-value>0</span> / {LIMITS.detalleMax}
        </p>
      </div>
      <button type="button" class="skip-step" data-skip data-js-only hidden>
        Saltar este paso
      </button>
    </fieldset>

    <!-- Paso 3 -->
    <fieldset class="step" data-step="3">
      <legend class="step-legend">
        <h3 class="step-title" id="s3-title" tabindex="-1">
          ¿Cómo te llamas?
        </h3>
      </legend>
      <label class="sr-only" for="nombre">
        Nombre
      </label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        class="field"
        autocomplete="given-name"
        placeholder="Tu nombre"
        autocapitalize="words"
        spellcheck="false"
        required
        minlength={LIMITS.nombreMin}
        maxlength={LIMITS.nombreMax}
        enterkeyhint="next"
        aria-describedby="err-nombre"
      />
      <p class="field-error" id="err-nombre" data-error="nombre" hidden>
        <CircleAlert size={16} stroke-width={1.75} aria-hidden="true" />
        <span></span>
      </p>
    </fieldset>

    <!-- Paso 4 -->
    <fieldset class="step" data-step="4">
      <legend class="step-legend">
        <h3 class="step-title" id="s4-title" tabindex="-1">
          ¿A qué número te escribo?
        </h3>
      </legend>
      <label class="sr-only" for="telefono">
        Teléfono móvil
      </label>
      <div class="phone-row">
        <label class="sr-only" for="prefijo">
          Prefijo internacional
        </label>
        <input
          id="prefijo"
          name="prefijo"
          type="tel"
          inputmode="tel"
          class="field prefix"
          autocomplete="tel-country-code"
          value="+34"
          maxlength="5"
        />
        <input
          id="telefono"
          name="telefono"
          type="tel"
          inputmode="tel"
          class="field"
          autocomplete="tel"
          placeholder="Tu móvil"
          required
          maxlength="22"
          enterkeyhint="send"
          aria-describedby="err-telefono"
        />
      </div>
      <p class="field-error" id="err-telefono" data-error="telefono" hidden>
        <CircleAlert size={16} stroke-width={1.75} aria-hidden="true" />
        <span></span>
      </p>

      <div class="consent">
        <input
          id="consentimiento_salud"
          name="consentimiento_salud"
          type="checkbox"
          value="1"
          class="consent-input"
          required
          aria-describedby="err-consentimiento"
        />
        <label for="consentimiento_salud" class="consent-label">
          He leído la{' '}
          <a class="link" href="/privacidad" target="_blank" rel="noopener">
            política de privacidad<span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>{' '}
          y consiento el tratamiento de los datos de salud que he indicado para valorar mi caso.
        </label>
      </div>
      <p class="field-error" id="err-consentimiento" data-error="consentimiento" hidden>
        <CircleAlert size={16} stroke-width={1.75} aria-hidden="true" />
        <span></span>
      </p>

      <p class="form-error" data-form-error role="alert" hidden></p>
    </fieldset>

    <!-- Navegación común: anclada abajo de la tarjeta en modo un paso por pantalla. -->
    <div class="form-nav">
      <button type="button" class="step-back" data-back data-js-only hidden>
        <ArrowLeft size={18} stroke-width={1.75} aria-hidden="true" />
        Atrás
      </button>
      <button type="button" class="btn btn-primary step-next" data-next data-js-only hidden>
        <span>Continuar</span>
        <ArrowRight
          size={20}
          stroke-width={1.75}
          aria-hidden="true"
          class="btn-icon btn-icon-arrow"
        />
      </button>
      <button type="submit" class="btn btn-primary step-submit" data-submit>
        <span class="spinner" aria-hidden="true" hidden></span>
        <span data-submit-label>Enviar y valorar mi caso</span>
      </button>
    </div>
    <p class="nojs-help" data-nojs-only>
      ¿Algún problema con el formulario? Escríbeme a{' '}
      <a class="link" href="mailto:info@rehabilitywod.com">
        info@rehabilitywod.com
      </a>
      .
    </p>
  </form>
</div>

<style>
  .form-card {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    padding: 18px 16px;
    border: 1px solid var(--hair-on-dark);
    border-radius: var(--radius);
    background: rgba(18, 18, 18, 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8);
    color: var(--ink-on-dark);
    text-align: left;
  }

  /* Modo un paso por pantalla: la tarjeta mide lo que su paso (sin huecos) y form.ts anima el
     cambio de alto entre pasos. */
  .form-card:global(.is-enhanced) {
    overflow: hidden;
  }

  .form-card:global(.is-enhanced) .lead-form {
    position: relative;
  }

  .form-card:global(.is-resizing) {
    transition: height 0.28s var(--ease);
  }

  /* Progreso: "Paso 1 de 4" y barra segmentada en 4 tramos. */
  .progress {
    margin-bottom: 22px;
  }

  .progress-text {
    margin: 0 0 8px;
  }

  .progress-track {
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    -webkit-mask-image: repeating-linear-gradient(
      90deg,
      #000 0 calc(25% - 3px),
      transparent calc(25% - 3px) 25%
    );
    mask-image: repeating-linear-gradient(
      90deg,
      #000 0 calc(25% - 3px),
      transparent calc(25% - 3px) 25%
    );
    border-radius: 4px;
    overflow: hidden;
  }

  .progress-bar {
    width: 100%;
    height: 100%;
    background: var(--brand-bright);
    transform-origin: left center;
    transform: scaleX(0.25);
    transition: transform 0.45s var(--ease);
  }

  .hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
  }

  .step {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .step + .step {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--hair-on-dark);
  }

  .form-card:global(.is-enhanced) .step {
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Transiciones entre pasos: hacia delante entra desde +28 px y el anterior sale a -28 px
     (280 ms); hacia atrás, al revés. form.ts pone --dir (1 o -1). */
  .form-card:global(.is-enhanced) .step:global(.is-entering) {
    animation: step-in 0.28s var(--ease) both;
  }

  .form-card:global(.is-enhanced) .step:global(.is-leaving) {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    animation: step-out 0.28s var(--ease) both;
  }

  @keyframes step-in {
    from {
      opacity: 0;
      transform: translate3d(calc(var(--dir, 1) * 28px), 0, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes step-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translate3d(calc(var(--dir, 1) * -28px), 0, 0);
    }
  }

  .step-legend {
    padding: 0;
    margin-bottom: 20px;
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.25rem; /* 36 px */
    line-height: 0.9;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    outline: none;
  }

  .step-title:focus-visible {
    outline: 2px solid var(--brand-bright);
    outline-offset: 4px;
  }

  /* Opciones de "¿Qué te duele?": todas iguales. Móvil: 2 columnas x 4 filas, figura a la
     izquierda. Desde 768 px: 4 x 2, figura arriba y texto debajo. */
  .chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 10px;
  }

  .chip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 68px;
    padding: 8px 30px 8px 10px;
    border: 1px solid var(--hair-on-dark);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.2;
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease),
      transform 0.25s var(--ease);
    -webkit-tap-highlight-color: transparent;
  }

  .chip :global(.zone-icon) {
    flex: none;
    width: 30px;
    height: 48px;
    color: rgba(255, 255, 255, 0.34);
    transition: color 0.3s var(--ease);
  }

  .chip :global(.zone-dot) {
    fill: var(--brand-bright);
  }

  .chip :global(.zone-halo) {
    fill: var(--brand-bright);
    opacity: 0.28;
    transform-box: fill-box;
    transform-origin: center;
  }

  .chip :global(.zone-spine) {
    stroke: #121212;
  }

  .chip :global(.zone-q) {
    stroke: var(--void);
  }

  .chip-text {
    min-width: 0;
  }

  .chip:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .chip:hover {
      border-color: rgba(255, 255, 255, 0.3);
    }
  }

  .chip-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
    pointer-events: none;
  }

  .chip-check {
    position: absolute;
    top: 50%;
    right: 12px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: -10px;
    border-radius: 50%;
    background: var(--brand-bright);
    color: var(--void);
    transform: scale(0);
    transition: transform 0.3s var(--ease);
  }

  .chip:has(.chip-input:checked) {
    border-color: var(--brand-bright);
    background: rgba(5, 148, 103, 0.12);
  }

  .chip:has(.chip-input:checked) :global(.zone-icon) {
    color: rgba(255, 255, 255, 0.72);
  }

  /* La zona elegida late. */
  .chip:has(.chip-input:checked) :global(.zone-halo) {
    animation: zone-pulse 1.6s var(--ease) infinite;
  }

  @keyframes zone-pulse {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .chip:has(.chip-input:checked) .chip-check {
    transform: scale(1);
  }

  .chip:has(.chip-input:focus-visible) {
    outline: 2px solid var(--brand-bright);
    outline-offset: 3px;
  }

  /* Campos */

  .field {
    display: block;
    width: 100%;
    min-height: 56px;
    padding: 14px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    background: var(--void);
    color: var(--ink-on-dark);
    font: inherit;
    font-size: 1.0625rem; /* ≥16 px: iOS no hace zoom */
    line-height: 1.4;
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .field::placeholder {
    color: #8b8f96;
  }

  .field:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .field:focus {
    outline: none;
    border-color: var(--brand-bright);
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.2);
  }

  .field:focus-visible {
    outline: none;
  }

  .field[aria-invalid='true'] {
    border-color: #ffffff;
  }

  .textarea {
    min-height: 116px;
    resize: vertical;
  }

  .field-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-top: 8px;
  }

  .field-meta .field-error {
    margin-top: 0;
  }

  .field-count {
    margin: 0 0 0 auto;
    font-size: 0.8125rem;
    color: var(--muted-on-dark);
    white-space: nowrap;
  }

  .field-error {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    color: #ffffff;
  }

  .field-error[hidden] {
    display: none;
  }

  .field-error :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--brand-bright);
  }

  .phone-row {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 8px;
  }

  .prefix {
    text-align: center;
    padding-inline: 8px;
  }

  .skip-step {
    align-self: flex-start;
    min-height: 44px;
    margin-top: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-on-dark);
    font: inherit;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Casilla de consentimiento personalizada (22 px) con check animado. */
  .consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    margin-top: 22px;
  }

  .consent-input {
    position: relative;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin: 2px 0 0;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    background: var(--void);
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  /* Área táctil de 44 px sin cambiar el tamaño visual. */
  .consent-input::before {
    content: '';
    position: absolute;
    inset: -11px;
  }

  .consent-input::after {
    content: '';
    width: 6px;
    height: 11px;
    margin-top: -3px;
    border: solid #ffffff;
    border-width: 0 2.2px 2.2px 0;
    transform: rotate(45deg) scale(0);
    transition: transform 0.3s var(--ease);
  }

  .consent-input:checked {
    border-color: var(--brand-bright);
    background: var(--brand-strong);
  }

  .consent-input:checked::after {
    transform: rotate(45deg) scale(1);
  }

  .consent-input:focus-visible {
    outline: 2px solid var(--brand-bright);
    outline-offset: 3px;
  }

  .consent-input[aria-invalid='true'] {
    border-color: #ffffff;
  }

  .consent-label {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgba(245, 245, 242, 0.88);
    cursor: pointer;
  }

  .form-notice {
    margin: 0 0 20px !important;
  }

  .form-error {
    margin-top: 20px;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 12px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: #ffffff;
  }

  .form-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
  }

  .step-next,
  .step-submit {
    flex: 1;
    white-space: normal;
  }

  .step-submit[hidden],
  .step-next[hidden],
  .step-back[hidden] {
    display: none;
  }

  /* "Atrás": solo icono y texto, discreto. */
  .step-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 12px 0 4px;
    border: 0;
    background: none;
    color: var(--muted-on-dark);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: color 0.25s var(--ease);
  }

  .step-back:hover {
    color: var(--ink-on-dark);
  }

  /* Móvil: el botón de envío ocupa la fila entera (sin partirse) y "Atrás" va debajo. */
  @media (width < 440px) {
    .form-nav:global(.is-final) {
      flex-wrap: wrap;
      gap: 4px;
    }

    .step-submit {
      flex-basis: 100%;
      order: -1;
    }

    .form-nav:global(.is-final) .step-back {
      margin-inline: auto;
    }
  }

  /* Pantallas muy estrechas: "Enviar y valorar mi caso" en una sola línea. */
  @media (width < 360px) {
    .step-submit {
      padding-inline: 14px;
      font-size: 0.9375rem;
    }
  }

  .spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .nojs-help {
    margin-top: 16px;
    font-size: 0.875rem;
    color: var(--muted-on-dark);
  }

  .form-card:global(.is-enhanced) [data-nojs-only] {
    display: none;
  }

  @media (width >= 768px) {
    .form-card {
      max-width: 640px;
      padding: 40px 44px;
    }

    .chips {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .chip {
      flex-direction: column;
      justify-content: flex-start;
      gap: 12px;
      min-height: 132px;
      padding: 18px 8px 14px;
      text-align: center;
    }

    .chip :global(.zone-icon) {
      width: 36px;
      height: 58px;
    }

    .chip-check {
      top: 10px;
      right: 10px;
      margin-top: 0;
    }
  }
</style>
