---
/**
 * Preguntas frecuentes: acordeón con separadores --hair, "+" que rota 45° y altura animada con
 * grid-template-rows (0fr → 1fr). Sin JS (sin la clase .js en <html>) las respuestas se ven.
 */
import Plus from '@lucide/astro/icons/plus';

const faqs = [
  {
    q: '¿Cómo me vas a ayudar si no me tratas en persona?',
    a: 'No necesitas que te toque. Necesitas una buena evaluación, un plan adaptado a ti y alguien que te acompañe en todo el proceso.',
  },
  {
    q: '¿Cómo sé si esto es para mí?',
    a: 'Si entrenas CrossFit y arrastras un dolor que no se va, seguramente sí. Lo vemos en la videollamada y, si no, te lo digo claro.',
  },
  {
    q: '¿Qué garantías tengo?',
    a: 'No te prometo resultados en dos semanas. Te garantizo un proceso en el que no estás solo: probamos, ajustamos y afinamos.',
  },
  {
    q: '¿Y si ya tengo pruebas o diagnóstico por imagen?',
    a: 'Genial, las usamos como apoyo. Pero lo que marca el rumbo es cómo te afecta y cómo responde tu cuerpo al esfuerzo.',
  },
];
---

<div class="faq" data-faq>
  <h3 class="faq-title">Preguntas frecuentes</h3>
  <div class="faq-list">
    {faqs.map((item, i) => (
      <div class="faq-item">
        <h4 class="faq-h">
          <button
            type="button"
            class="faq-q"
            id={`faq-q-${i}`}
            aria-expanded="false"
            aria-controls={`faq-a-${i}`}
            data-faq-toggle
          >
            <span>{item.q}</span>
            <Plus size={22} stroke-width={1.75} aria-hidden="true" class="faq-icon" />
          </button>
        </h4>
        <div class="faq-panel" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
          <div class="faq-inner">
            <p class="faq-a">{item.a}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .faq {
    max-width: 720px;
    margin: 26px auto 0;
    text-align: left;
  }

  .faq-title {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem; /* 32 px */
    line-height: 0.9;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    text-align: center;
  }

  .faq-item {
    border-bottom: 1px solid var(--hair-on-dark);
  }

  .faq-h {
    margin: 0;
    font: inherit;
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 48px;
    padding: 10px 0;
    border: 0;
    background: none;
    color: var(--ink-on-dark);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: left;
  }

  .faq-q :global(.faq-icon) {
    flex: none;
    color: var(--brand-bright);
    transition: transform 0.4s var(--ease);
  }

  .faq-q[aria-expanded='true'] :global(.faq-icon) {
    transform: rotate(45deg);
  }

  .faq-q:focus-visible {
    outline-offset: 2px;
  }

  .faq-panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  :global(html.js) .faq-panel {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.45s var(--ease),
      visibility 0s linear 0.45s;
  }

  :global(html.js) .faq-panel.is-open {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.45s var(--ease),
      visibility 0s linear 0s;
  }

  .faq-inner {
    min-height: 0;
    overflow: hidden;
  }

  .faq-a {
    padding: 0 38px 20px 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted-on-dark);
  }

  @media (width >= 768px) {
    .faq {
      margin-top: 96px;
    }

    .faq-title {
      margin-bottom: 20px;
    }
  }
</style>
