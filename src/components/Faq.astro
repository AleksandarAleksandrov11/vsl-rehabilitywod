---
/**
 * Preguntas frecuentes: sección propia sobre --brand-soft (verde muy claro), entre el formulario
 * y la banda de cierre. Acordeón con separadores, "+" que rota 45° y altura animada con
 * grid-template-rows (0fr → 1fr). Sin JS (sin la clase .js en <html>) las respuestas se ven.
 */
import Plus from '@lucide/astro/icons/plus';
import SplitWords from './SplitWords.astro';

const faqs = [
  {
    q: '¿Cómo me vas a ayudar si no me tratas en persona?',
    a: 'No necesitas que te toque. Necesitas una buena evaluación, un plan adaptado a ti y alguien que te acompañe en todo el proceso.',
  },
  {
    q: '¿Cómo sé si esto es para mí?',
    a: 'Si entrenas CrossFit y arrastras un dolor que no se va, seguramente sí. Lo vemos en la videollamada y, si no, te lo digo claro.',
  },
  {
    q: '¿Qué garantías tengo?',
    a: 'No te prometo resultados en dos semanas. Te garantizo un proceso en el que no estás solo: probamos, ajustamos y afinamos.',
  },
  {
    q: '¿Y si ya tengo pruebas o diagnóstico por imagen?',
    a: 'Genial, las usamos como apoyo. Pero lo que marca el rumbo es cómo te afecta y cómo responde tu cuerpo al esfuerzo.',
  },
];
---

<section id="faq" class="faq-section section-y" data-theme="light" aria-labelledby="faq-title">
  <div class="container-x">
    <div class="faq" data-faq>
      <SplitWords
        as="h2"
        id="faq-title"
        class="h2-display faq-title"
        parts={['Preguntas', { text: 'frecuentes', accent: true }]}
      />
      <div class="faq-list">
        {faqs.map((item, i) => (
          <div class="faq-item">
            <h3 class="faq-h">
              <button
                type="button"
                class="faq-q"
                id={`faq-q-${i}`}
                aria-expanded="false"
                aria-controls={`faq-a-${i}`}
                data-faq-toggle
              >
                <span>{item.q}</span>
                <Plus size={22} stroke-width={1.75} aria-hidden="true" class="faq-icon" />
              </button>
            </h3>
            <div class="faq-panel" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div class="faq-inner">
                <p class="faq-a">{item.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-section {
    background: var(--brand-soft);
    color: var(--ink);
  }

  .faq {
    max-width: 760px;
    margin: 0 auto;
    text-align: left;
  }

  .faq-title {
    margin-bottom: var(--title-gap);
    text-align: center;
  }

  .faq-list {
    border-top: 1px solid rgba(6, 34, 26, 0.14);
  }

  .faq-item {
    border-bottom: 1px solid rgba(6, 34, 26, 0.14);
  }

  .faq-h {
    margin: 0;
    font: inherit;
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 56px;
    padding: 16px 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: left;
  }

  .faq-q :global(.faq-icon) {
    flex: none;
    color: var(--brand-strong);
    transition: transform 0.4s var(--ease);
  }

  .faq-q[aria-expanded='true'] :global(.faq-icon) {
    transform: rotate(45deg);
  }

  .faq-q:focus-visible {
    outline-offset: 2px;
  }

  .faq-panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  :global(html.js) .faq-panel {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.45s var(--ease),
      visibility 0s linear 0.45s;
  }

  :global(html.js) .faq-panel.is-open {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.45s var(--ease),
      visibility 0s linear 0s;
  }

  .faq-inner {
    min-height: 0;
    overflow: hidden;
  }

  .faq-a {
    padding: 0 38px 22px 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (width >= 768px) {
    .faq-q {
      min-height: 64px;
      font-size: 1.1875rem;
    }

    .faq-a {
      font-size: 1.0625rem;
    }
  }
</style>
