---
/**
 * Botón de WhatsApp con el mensaje ya escrito.
 * - variant="float": burbuja fija abajo a la derecha (escritorio). Aparece al pasar el hero.
 * - variant="inline": botón cuadrado para la barra fija de móvil, junto al CTA.
 */
import { CONFIG, WHATSAPP_TEXT, whatsappLink } from '../config';

interface Props {
  variant?: 'float' | 'inline';
  location: 'float' | 'sticky';
  tabindex?: number;
}

const { variant = 'float', location, tabindex } = Astro.props;
const href = whatsappLink(WHATSAPP_TEXT);
const label = `Escribir por WhatsApp al ${CONFIG.telefono}`;
---

<a
  class:list={['wa', `wa-${variant}`]}
  href={href}
  target="_blank"
  rel="noopener"
  data-cta={`whatsapp_${location}`}
  data-whatsapp={variant === 'float' ? 'float' : undefined}
  tabindex={tabindex}
  aria-label={label}
>
  <svg
    viewBox="0 0 24 24"
    width="26"
    height="26"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.15h-.01c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.06s.89 2.39 1.01 2.56c.12.16 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"></path>
  </svg>
  <span class="sr-only">Escribir por WhatsApp (se abre en una pestaña nueva)</span>
</a>

<style>
  .wa {
    display: grid;
    place-items: center;
    color: #ffffff;
    background: #25d366;
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .wa:hover {
    background: #1fb855;
  }

  .wa:active {
    transform: scale(0.95);
  }

  /* Burbuja fija (escritorio). */
  .wa-float {
    position: fixed;
    z-index: 45;
    right: max(20px, env(safe-area-inset-right));
    bottom: calc(20px + env(safe-area-inset-bottom));
    width: 58px;
    height: 58px;
    border-radius: 50%;
    box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.55);
    opacity: 0;
    transform: translate3d(0, 16px, 0) scale(0.9);
    visibility: hidden;
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease),
      visibility 0s linear 0.4s;
  }

  .wa-float:global(.is-visible) {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease),
      visibility 0s linear 0s;
  }

  .wa-float:hover {
    transform: translate3d(0, -3px, 0);
    box-shadow: 0 20px 36px -12px rgba(0, 0, 0, 0.6);
  }

  /* En móvil la burbuja sobra: el botón va dentro de la barra fija. */
  @media (width < 768px) {
    .wa-float {
      display: none;
    }
  }

  /* Botón de la barra fija de móvil. */
  .wa-inline {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      transform: none;
    }
  }
</style>
