---
/**
 * Footer: marca y un CTA al formulario, enlaces legales (en una pestaña nueva, para no salir de la
 * landing) con "Configurar cookies", el © y, al final del todo, "REHABILITYWOD" a todo el ancho.
 * Sin redes ni contacto (no hay salidas de la landing; los datos de contacto están en las páginas
 * legales). Las letras del nombre grande suben una a una al entrar en pantalla y después una ola
 * suave las recorre cada pocos segundos (sin movimiento con prefers-reduced-motion). En escritorio
 * cada letra también sube al pasar el ratón.
 */
import CtaButton from './CtaButton.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  /** En la home deja hueco para la barra CTA fija en móvil. */
  withStickyGap?: boolean;
  /** CTA al formulario (no en /gracias, que ya tiene "Enviar otra solicitud"). */
  cta?: boolean;
}

const { withStickyGap = false, cta = true } = Astro.props;
const year = new Date().getFullYear();
const ctaHref = Astro.url.pathname === '/' ? '#valoracion' : '/#valoracion';

const giant = [...'REHABILITY'].map((ch) => ({ ch, wod: false }));
giant.push(...[...'WOD'].map((ch) => ({ ch, wod: true })));

const legal = [
  { href: '/aviso-legal', text: 'Aviso legal' },
  { href: '/privacidad', text: 'Privacidad' },
  { href: '/cookies', text: 'Cookies' },
];
---

<footer class:list={['site-footer', withStickyGap && 'has-sticky-gap']} data-theme="dark">
  <div class="container-x">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a href="/" class="footer-brand" aria-label="RehabilityWOD, ir al inicio">
          <Wordmark class="footer-wordmark" />
        </a>
        <p class="footer-tag">Fisioterapia online para atletas de CrossFit</p>
        {cta && (
          <div class="footer-cta">
            <CtaButton href={ctaHref} location="footer">
              Quiero valorar mi caso
            </CtaButton>
          </div>
        )}
      </div>

      <nav class="footer-col" aria-label="Legal">
        <p class="footer-head">Legal</p>
        <ul class="footer-list" role="list">
          {legal.map(({ href, text }) => (
            <li>
              <a class="footer-link link-grow" href={href} target="_blank" rel="noopener">
                {text}
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            </li>
          ))}
          <li>
            <button
              type="button"
              class="footer-link footer-button link-grow"
              data-open-cookie-settings
            >
              Configurar cookies
            </button>
          </li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">© {year} Gerard Barrantes Bautista · RehabilityWOD</p>
    </div>
  </div>

  <div class="footer-giant" aria-hidden="true" data-reveal>
    <span class="footer-giant-word">
      {giant.map(({ ch, wod }, i) => (
        <span class:list={['fg-letter', wod && 'fg-wod']} style={`--i:${i}`}>
          <span class="fg-inner">{ch}</span>
        </span>
      ))}
    </span>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: 64px;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--void);
    color: var(--ink-on-dark);
    border-top: 1px solid var(--hair-on-dark);
    overflow: hidden;
  }

  /* Hueco para que la barra CTA fija (móvil) no tape el footer. */
  @media (width < 768px) {
    .site-footer.has-sticky-gap {
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }
  }

  .footer-top {
    display: grid;
    gap: 40px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .footer-brand :global(.footer-wordmark) {
    font-size: 1.75rem;
  }

  .footer-tag {
    margin-top: 6px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted-on-dark);
  }

  .footer-cta {
    margin-top: 24px;
  }

  .footer-head {
    margin-bottom: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }

  .footer-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    color: var(--ink-on-dark);
    font-size: 0.9375rem;
    text-decoration: none;
    overflow-wrap: anywhere;
    background-position: 0 calc(50% + 0.8em);
  }

  .footer-button {
    padding: 0;
    border: 0;
    background-color: transparent;
    font: inherit;
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--hair-on-dark);
  }

  .footer-copy {
    font-size: 0.875rem;
    color: var(--muted-on-dark);
  }

  /* "REHABILITYWOD" a todo el ancho del contenedor. */
  .footer-giant {
    container-type: inline-size;
    width: min(100% - 2 * var(--gutter), 1240px);
    margin: 40px auto 0;
    padding-bottom: 20px;
    user-select: none;
  }

  .footer-giant-word {
    display: flex;
    justify-content: space-between;
    padding-top: 0.08em;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 800;
    /* "REHABILITYWOD" en Big Shoulders 800 mide 5,42 veces su tamaño de letra. */
    font-size: calc(100cqi / 5.5);
    line-height: 0.82;
    letter-spacing: 0;
    color: var(--ink-on-dark);
  }

  .fg-letter {
    display: block;
  }

  .fg-inner {
    display: block;
  }

  .fg-wod {
    color: var(--brand-bright);
  }

  /* Entrada: las letras suben una a una desde debajo de la línea. */
  .footer-giant:global(.reveal-armed) .fg-letter {
    transform: translate3d(0, 105%, 0);
  }

  .footer-giant:global(.reveal-armed.is-in) .fg-letter {
    transform: none;
    transition: transform 0.9s var(--ease);
    transition-delay: calc(var(--i) * 45ms);
  }

  /* Después, una ola suave recorre la palabra cada 5 s. */
  .fg-inner {
    animation: fg-wave 5s var(--ease) infinite;
    animation-delay: calc(1.2s + var(--i) * 70ms);
  }

  @keyframes fg-wave {
    0%,
    16%,
    100% {
      transform: none;
    }
    8% {
      transform: translate3d(0, -7%, 0);
    }
  }

  @media (hover: hover) and (width >= 1024px) {
    .fg-letter {
      transition: transform 0.5s var(--ease);
    }

    .fg-letter:hover,
    .footer-giant:global(.reveal-armed.is-in) .fg-letter:hover {
      transform: translate3d(0, -6%, 0);
      transition-delay: 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fg-inner {
      animation: none;
    }
  }

  @media (width >= 768px) {
    .site-footer {
      padding-top: 96px;
    }

    .footer-top {
      gap: 48px;
    }

    .footer-bottom {
      margin-top: 72px;
    }

    .footer-giant {
      margin-top: 56px;
      padding-bottom: 32px;
    }
  }

  /* Tablet y escritorio: marca y CTA a la izquierda, legal a la derecha. */
  @media (width >= 768px) {
    .footer-top {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 64px;
      align-items: start;
    }
  }
</style>
