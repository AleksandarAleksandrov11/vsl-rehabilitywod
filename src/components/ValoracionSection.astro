---
import LeadForm from './LeadForm.astro';
import Faq from './Faq.astro';
---

<section
  id="valoracion"
  class="section-y valoracion"
  data-theme="dark"
  aria-labelledby="valoracion-title"
>
  <div class="container-x">
    <div class="valoracion-head" data-reveal>
      <p class="eyebrow">Valoración gratuita</p>
      <h2 id="valoracion-title" class="h2-display mt-4">
        Cuéntame qué te pasa.
      </h2>
      <p class="text-body mt-5 text-ink-on-dark/85">
        Te escribo por WhatsApp para una videollamada de valoración gratuita. Si no es para ti, te
        lo diré claro.
      </p>
      <p class="text-secondary mt-3 text-muted-on-dark">
        Abro plazas nuevas cuando tengo hueco para darte el seguimiento que mereces.
      </p>
    </div>

    <div class="mt-10 md:mt-12">
      <LeadForm />
    </div>

    <Faq />
  </div>
</section>

<style>
  .valoracion {
    position: relative;
    isolation: isolate;
    background: var(--void);
    color: var(--ink-on-dark);
    border-top: 1px solid var(--hair-on-dark);
  }

  /* Glow verde muy sutil (< 6 % de opacidad). */
  .valoracion::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(
      60% 40% at 50% 22%,
      rgba(52, 211, 153, 0.05) 0%,
      rgba(52, 211, 153, 0) 100%
    );
    pointer-events: none;
  }

  .valoracion-head {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  @media (width >= 768px) {
    .valoracion-head {
      max-width: 720px;
    }

    .valoracion-head p {
      max-width: 560px;
      margin-inline: auto;
    }
  }
</style>
