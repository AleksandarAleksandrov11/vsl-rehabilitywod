---
/**
 * Sección 6: valoración. Foto de box a sangre casi tapada por un velo (--void al 88 %) y un
 * resplandor verde tenue arriba. En móvil la foto solo asoma arriba para no restar legibilidad.
 */
import LeadForm from './LeadForm.astro';
import SplitWords from './SplitWords.astro';
import formPhoto from '../assets/photos/form-bg.jpg';
import { WIDTHS, responsive } from '../lib/images';

const bg = await responsive(formPhoto, WIDTHS.landscape);
---

<section
  id="valoracion"
  class="valoracion section-y"
  data-theme="dark"
  aria-labelledby="valoracion-title"
>
  <div class="valoracion-media" aria-hidden="true">
    <picture>
      <source type="image/avif" srcset={bg.avif} sizes="100vw" />
      <source type="image/webp" srcset={bg.webp} sizes="100vw" />
      <img
        src={bg.fallback}
        width={bg.width}
        height={bg.height}
        alt=""
        loading="lazy"
        decoding="async"
        class="valoracion-img"
      />
    </picture>
  </div>
  <div class="valoracion-veil" aria-hidden="true"></div>

  <div class="container-x">
    <div class="valoracion-head">
      <SplitWords
        id="valoracion-title"
        class="h2-display"
        parts={['Cuéntame', { br: 'always' }, { text: 'qué te pasa.', accent: true }]}
      />
      <p class="lead valoracion-lead reveal" data-reveal style="--i:2">
        Rellénalo en 30 segundos y únete a los más de 120 atletas recuperados.
      </p>
    </div>

    <div class="valoracion-form">
      <LeadForm />
    </div>
  </div>
</section>

<style>
  .valoracion {
    position: relative;
    isolation: isolate;
    background: var(--void);
    color: var(--ink-on-dark);
    overflow: hidden;
  }

  .valoracion-media {
    position: absolute;
    z-index: -2;
    top: 0;
    left: 0;
    right: 0;
    height: 720px;
  }

  .valoracion-media picture,
  .valoracion-img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .valoracion-img {
    object-fit: cover;
    object-position: 50% 30%;
    filter: contrast(1.03) saturate(0.95);
  }

  /* Velo casi opaco y resplandor verde arriba. En móvil la foto se funde con --void. */
  .valoracion-veil {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(70% 420px at 50% 0%, rgba(5, 148, 103, 0.18), rgba(5, 148, 103, 0) 100%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.84) 0, rgba(10, 10, 10, 0.9) 360px, #0a0a0a 720px);
  }

  .valoracion-head {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .valoracion-lead {
    margin-top: 18px;
  }

  .valoracion-form {
    margin-top: var(--title-gap);
  }

  @media (width >= 768px) {
    .valoracion-media {
      inset: 0;
      height: auto;
    }

    .valoracion-veil {
      background:
        radial-gradient(60% 520px at 50% 0%, rgba(5, 148, 103, 0.16), rgba(5, 148, 103, 0) 100%),
        rgba(10, 10, 10, 0.88);
    }

    .valoracion-head {
      max-width: 720px;
    }

    .valoracion-lead {
      max-width: 560px;
      margin: 24px auto 0;
    }
  }
</style>
