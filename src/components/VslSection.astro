---
/**
 * Sección 2: VSL con el reproductor de YouTube (modo de privacidad mejorada) en facade.
 * Se ve la portada del vídeo servida desde la web con el botón de play de YouTube; el iframe
 * solo se carga al pulsar play (vsl.ts) y arranca solo.
 */
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import Crosshair from '@lucide/astro/icons/crosshair';
import Route from '@lucide/astro/icons/route';
import SplitWords from './SplitWords.astro';
import SectionCta from './SectionCta.astro';
import coverPhoto from '../assets/photos/vsl-cover.jpg';
import { WIDTHS, responsive } from '../lib/images';
import { CONFIG } from '../config';

const id = CONFIG.vslYoutubeId;
const embedSrc = `https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1&playsinline=1&enablejsapi=1`;
const poster = await responsive(coverPhoto, WIDTHS.landscape);
const sizes = '(min-width: 1088px) 1040px, calc(100vw - 24px)';

const keys = [
  { Icon: RotateCcw, text: 'Por qué recaes' },
  { Icon: Crosshair, text: 'Qué falla en tu enfoque' },
  { Icon: Route, text: 'Qué hacer desde hoy' },
];
---

<section id="video" class="vsl section-y tex-grain" data-theme="dark" aria-labelledby="vsl-title">
  <div class="vsl-glow" aria-hidden="true"></div>

  <div class="container-x vsl-head">
    <SplitWords
      id="vsl-title"
      class="h2-display vsl-title"
      start={1}
      parts={['¿Por qué sigues', { br: 'always' }, { text: 'con dolor?', accent: true }]}
    />
    <p class="lead vsl-lead reveal" data-reveal style="--i:3">
      Lo que nadie te ha explicado de tu lesión.
    </p>
  </div>

  <div class="vsl-frame reveal-scale" data-reveal data-vsl data-embed={embedSrc}>
    <button
      type="button"
      class="vsl-facade"
      data-vsl-play
      aria-label={`Reproducir el vídeo: ${CONFIG.vslTitle} (${CONFIG.vslMinutes} minutos)`}
    >
      <picture class="vsl-picture">
        <source type="image/avif" srcset={poster.avif} sizes={sizes} />
        <source type="image/webp" srcset={poster.webp} sizes={sizes} />
        <img
          src={poster.fallback}
          width={poster.width}
          height={poster.height}
          alt=""
          loading="lazy"
          decoding="async"
          class="vsl-poster"
        />
      </picture>
      <svg
        class="vsl-play"
        viewBox="0 0 68 48"
        width="68"
        height="48"
        aria-hidden="true"
        focusable="false"
      >
        <path
          class="vsl-play-bg"
          d="M66.52 7.74a8.6 8.6 0 0 0-6.02-6.1C55.2.2 34 .2 34 .2s-21.2 0-26.5 1.44a8.6 8.6 0 0 0-6.02 6.1C.06 13.1.06 24 .06 24s0 10.9 1.42 16.26a8.6 8.6 0 0 0 6.02 6.1C12.8 47.8 34 47.8 34 47.8s21.2 0 26.5-1.44a8.6 8.6 0 0 0 6.02-6.1C67.94 34.9 67.94 24 67.94 24s0-10.9-1.42-16.26Z"
        ></path>
        <path d="M45 24 27 14v20" fill="#ffffff"></path>
      </svg>
    </button>
    <noscript>
      <a class="vsl-noscript" href={`https://www.youtube.com/watch?v=${id}`}>
        Ver el vídeo en YouTube
      </a>
    </noscript>
  </div>

  <div class="container-x">
    <ul class="vsl-keys" role="list">
      {keys.map(({ Icon, text }, i) => (
        <li class="vsl-key reveal" data-reveal style={`--i:${i}`}>
          <span class="icon-ring" aria-hidden="true">
            <Icon size={20} stroke-width={1.75} />
          </span>
          <span>{text}</span>
        </li>
      ))}
    </ul>
    <SectionCta location="vsl" />
  </div>
</section>

<style>
  .vsl {
    position: relative;
    background: var(--void);
    color: var(--ink-on-dark);
    overflow: hidden;
    --grain: 0.05;
  }

  /* Resplandor radial verde detrás del reproductor. */
  .vsl-glow {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 46%;
    width: min(1400px, 160vw);
    height: min(900px, 110vw);
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(5, 148, 103, 0.16), rgba(5, 148, 103, 0) 100%);
    pointer-events: none;
  }

  .vsl-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .vsl-lead {
    margin-top: 16px;
  }

  /* Reproductor: sangra hasta 12 px del borde en móvil; máximo 1040 px en escritorio. */
  .vsl-frame {
    position: relative;
    z-index: 2;
    aspect-ratio: 16 / 9;
    width: calc(100% - 24px);
    max-width: 1040px;
    margin: var(--title-gap) auto 0;
    border: 1px solid var(--hair-on-dark);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(5, 148, 103, 0.35);
  }

  .vsl-facade {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: #ffffff;
    text-align: left;
    overflow: hidden;
    border-radius: inherit;
    cursor: pointer;
  }

  .vsl-facade:focus-visible {
    outline-offset: -4px;
    border-radius: var(--radius);
  }

  .vsl-picture,
  .vsl-poster {
    display: block;
    width: 100%;
    height: 100%;
  }

  .vsl-poster {
    object-fit: cover;
  }

  /* Botón de play con el aspecto del de YouTube (el mismo que se ve al cargar el reproductor). */
  .vsl-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 68px;
    height: 48px;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .vsl-play-bg {
    fill: #212121;
    fill-opacity: 0.8;
    transition:
      fill 0.1s cubic-bezier(0.4, 0, 1, 1),
      fill-opacity 0.1s cubic-bezier(0.4, 0, 1, 1);
  }

  .vsl-facade:hover .vsl-play-bg,
  .vsl-facade:focus-visible .vsl-play-bg {
    fill: #ff0000;
    fill-opacity: 1;
  }

  .vsl-frame :global(iframe) {
    position: absolute;
    z-index: 3;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }

  .vsl-frame :global(iframe.is-ready) {
    opacity: 1;
  }

  .vsl-noscript {
    position: absolute;
    z-index: 4;
    left: 16px;
    bottom: 16px;
    color: #ffffff;
    font-weight: 600;
  }

  /* 3 claves: una columna centrada en móvil, en fila en escritorio. */
  .vsl-keys {
    display: grid;
    justify-items: center;
    gap: 14px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .vsl-key {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .vsl-key :global(.icon-ring) {
    width: 32px;
    height: 32px;
  }

  @media (width >= 768px) {
    .vsl-frame {
      width: calc(100% - 2 * var(--gutter));
    }

    .vsl-keys {
      grid-template-columns: repeat(3, auto);
      justify-content: center;
      gap: 48px;
      margin-top: 56px;
    }
  }
</style>
