---
import Wordmark from './Wordmark.astro';
import CtaButton from './CtaButton.astro';

interface Props {
  /** En la home el header es transparente sobre el hero; en el resto, sólido. */
  overlay?: boolean;
  ctaHref?: string;
}

const { overlay = false, ctaHref = '#valoracion' } = Astro.props;
---

<div class="top-sentinel" data-top-sentinel aria-hidden="true"></div>
<header class:list={['site-header', !overlay && 'is-solid']} data-header data-theme="dark">
  <div class="container-x header-inner">
    <a href="/" class="header-brand" aria-label="RehabilityWOD, ir al inicio">
      <Wordmark class="header-wordmark" />
    </a>
    <CtaButton href={ctaHref} location="header" size="sm" icon="none" class="header-cta">
      Valorar mi caso
    </CtaButton>
  </div>
  <div class="scroll-progress" aria-hidden="true">
    <span class="scroll-progress-bar" data-scroll-progress></span>
  </div>
</header>

<style>
  .top-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 24px;
    pointer-events: none;
  }

  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--header-h) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    color: var(--ink-on-dark);
    background-color: rgba(10, 10, 10, 0);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .site-header:global(.is-scrolled),
  .site-header.is-solid {
    background-color: rgba(10, 10, 10, 0.8);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--hair-on-dark);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
  }

  .header-brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .header-brand :global(.header-wordmark) {
    font-size: 1.3125rem;
  }

  @media (width >= 768px) {
    .header-brand :global(.header-wordmark) {
      font-size: 1.5rem;
    }
  }

  @media (width < 360px) {
    .header-brand :global(.header-wordmark) {
      font-size: 1.125rem;
    }

    .site-header :global(.header-cta) {
      padding-inline: 16px;
      font-size: 0.9375rem;
    }
  }

  /* Barra de progreso de scroll: 2 px en --brand-bright en el borde inferior. */
  .scroll-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  .scroll-progress-bar {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--brand-bright);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
</style>
