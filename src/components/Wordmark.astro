---
interface Props {
  /** Sobre oscuro "WOD" va en --brand-bright; sobre claro, en --brand-strong. */
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className = '' } = Astro.props;
---

<span class:list={['wordmark', `wordmark-${tone}`, className]}>
  Rehability<span class="wordmark-wod">WOD</span>
</span>

<style>
  .wordmark {
    font-family: var(--font-text);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark-dark {
    color: var(--ink-on-dark);
  }

  .wordmark-dark .wordmark-wod {
    color: var(--brand-bright);
  }

  .wordmark-light {
    color: var(--ink);
  }

  .wordmark-light .wordmark-wod {
    color: var(--brand-strong);
  }
</style>
