---
/**
 * Sección 4: cómo funciona. Única sección teñida de verde (--brand-deep, rejilla y grano).
 * 3 pasos (en escritorio unidos por una línea con un punto que avanza con el scroll) y
 * 4 capturas reales de la app en marcos finos (carrusel en móvil, en fila en escritorio).
 */
import { Image } from 'astro:assets';
import SplitWords from './SplitWords.astro';
import SectionCta from './SectionCta.astro';
import app1 from '../assets/images/app-1.jpg';
import app2 from '../assets/images/app-2.jpg';
import app3 from '../assets/images/app-3.jpg';
import app4 from '../assets/images/app-4.jpg';

const steps = [
  {
    n: '01',
    title: 'Valoramos tu caso',
    text: 'Formulario y videollamada para entender qué te pasa.',
  },
  {
    n: '02',
    title: 'Tu plan en el móvil',
    text: 'Ejercicio específico y tus entrenos adaptados, en una app.',
  },
  {
    n: '03',
    title: 'Vuelves al 100 %',
    text: 'Preparamos tu vuelta y te enseño a no recaer.',
  },
];

// Capturas reales de la app (1080x2340). La barra de navegación de Android se recorta con CSS.
const shots = [
  {
    src: app1,
    caption: 'Tu plan de hoy',
    alt: 'Captura de la app de RehabilityWOD: plan de hoy con la sesión y las métricas personales',
  },
  {
    src: app2,
    caption: 'Entrenos adaptados',
    alt: 'Captura de la app: sesión de metcon con las adaptaciones indicadas por Gerard',
  },
  {
    src: app4,
    caption: 'Vídeo de cada ejercicio',
    alt: 'Captura de la app: ejercicio con vídeo explicativo y objetivo de la serie',
  },
  {
    src: app3,
    caption: 'Registro de dolor y sueño',
    alt: 'Captura de la app: registro diario de dolor, estrés y calidad del sueño',
  },
];
---

<section
  id="como-funciona"
  class="how section-y tex-grid tex-grain"
  data-theme="dark"
  aria-labelledby="how-title"
>
  <div class="container-x">
    <SplitWords
      id="how-title"
      class="h2-display how-title"
      parts={['Así', { text: 'funciona', accent: true }]}
    />

    <div class="steps-wrap">
      <div class="steps-rail" aria-hidden="true" data-rail>
        <span class="steps-rail-fill" data-rail-fill></span>
        <span class="steps-rail-dot" data-rail-dot></span>
      </div>
      <ol class="steps" role="list">
        {steps.map((step, i) => (
          <li class="step reveal" data-reveal style={`--i:${i}`}>
            <span class="step-num" aria-hidden="true">
              {step.n}
            </span>
            <div class="step-body">
              <h3 class="step-title">
                <span class="sr-only">Paso {i + 1}. </span>
                {step.title}
              </h3>
              <p class="step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <p class="eyebrow apps-eyebrow reveal" data-reveal>
      Dentro de la app
    </p>
  </div>

  <ul
    class="apps"
    role="list"
    aria-label="Capturas reales de la app"
    data-scroll-region
    data-reveal
  >
    {shots.map((shot, i) => (
      <li class="app" style={`--i:${i}`}>
        <figure class="app-figure">
          <div class="device">
            <div class="device-screen">
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[320, 480, 640, 840, 1080]}
                sizes="(min-width: 1024px) 240px, (min-width: 768px) 280px, 64vw"
                quality={85}
                loading="lazy"
                decoding="async"
                class="device-img"
              />
            </div>
          </div>
          <figcaption class="app-caption">{shot.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>

  <div class="container-x">
    <SectionCta location="how" label="Valorar mi caso" />
  </div>
</section>

<style>
  .how {
    position: relative;
    background: var(--brand-deep);
    color: var(--ink-on-dark);
    text-align: center;
    overflow: hidden;
    --grid-line: rgba(255, 255, 255, 0.04);
    --grain: 0.06;
  }

  /* ---------------- Pasos ---------------- */
  .steps-wrap {
    position: relative;
    margin-top: var(--title-gap);
  }

  .steps-rail {
    display: none;
  }

  .steps {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    padding: 22px 20px;
    border: 1px solid var(--hair-on-dark);
    border-radius: var(--radius);
    background: rgba(18, 18, 18, 0.6);
    transition:
      transform 0.5s var(--ease),
      border-color 0.5s var(--ease),
      opacity 0.8s var(--ease);
  }

  .step-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 4.5rem; /* 72 px */
    line-height: 0.85;
    letter-spacing: 0.01em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--brand-bright);
    transition: color 0.5s var(--ease);
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 7.7vw, 2rem); /* 30-32 px */
    line-height: 0.9;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  .step-text {
    margin-top: 10px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted-on-dark);
  }

  .step:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .step:hover {
      transform: translateY(-6px);
      border-color: rgba(5, 148, 103, 0.4);
    }

    .step:hover .step-num {
      color: var(--brand-bright);
    }
  }

  /* ---------------- App ---------------- */
  .apps-eyebrow {
    margin-top: 56px;
  }

  /* Móvil y tablet: carrusel con snap; cada móvil ocupa el 64 % del ancho y asoma el siguiente. */
  .apps {
    display: flex;
    gap: 18px;
    margin: 20px 0 0;
    padding: 8px calc(50% - 32vw) 12px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .apps::-webkit-scrollbar {
    display: none;
  }

  .app {
    flex: none;
    width: 64vw;
    max-width: 280px;
    scroll-snap-align: center;
  }

  .app-figure {
    margin: 0;
  }

  /* Marco fino: 8 px de bisel, sin isla ni muesca que tape la pantalla. La cámara es un punto
     sobre la barra de estado (que en las capturas está vacía en el centro). */
  .device {
    position: relative;
    padding: 8px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 40px;
    background: linear-gradient(160deg, #1f1f1f 0%, #0b0b0b 100%);
    box-shadow:
      0 36px 70px -34px rgba(0, 0, 0, 0.85),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }

  .device::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: 15px;
    left: 50%;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    background: #050505;
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.08);
  }

  .device-screen {
    aspect-ratio: 1080 / 2208;
    border-radius: 32px;
    background: #ffffff;
    overflow: hidden;
  }

  .device-screen :global(.device-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .app-caption {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink-on-dark);
  }

  .apps:global(.reveal-armed) .app {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
  }

  .apps:global(.reveal-armed.is-in) .app {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
    transition-delay: calc(var(--i) * 90ms);
  }

  @media (hover: hover) {
    .app:hover .device {
      transform: translate3d(0, -8px, 0);
      box-shadow:
        0 48px 80px -34px rgba(0, 0, 0, 0.9),
        inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    }
  }

  @media (width >= 768px) {
    .apps {
      gap: 24px;
      padding-inline: calc(50% - 140px);
    }

    .app {
      width: 280px;
    }

    .apps-eyebrow {
      margin-top: 88px;
    }
  }

  /* ---------------- Escritorio ---------------- */
  @media (width >= 1024px) {
    .steps-wrap {
      padding-top: 36px;
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .step {
      grid-template-columns: 1fr;
      align-items: start;
      align-content: start;
      gap: 22px;
      padding: 32px;
    }

    .step-title {
      font-size: 2rem;
    }

    .step-text {
      margin-top: 10px;
      font-size: 1.0625rem;
    }

    /* Línea horizontal que une los pasos, con un punto que avanza al hacer scroll. */
    .steps-rail {
      position: absolute;
      top: 0;
      left: calc((100% - 48px) / 6);
      right: calc((100% - 48px) / 6);
      display: block;
      height: 1px;
      background: rgba(255, 255, 255, 0.14);
    }

    .steps-rail-fill {
      position: absolute;
      inset: 0;
      background: var(--brand-bright);
      transform-origin: 0 50%;
      transform: scaleX(var(--p, 0));
    }

    .steps-rail-dot {
      position: absolute;
      top: -5px;
      left: -5px;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--brand-bright);
      box-shadow: 0 0 0 5px rgba(52, 211, 153, 0.16);
      transform: translate3d(var(--x, 0px), 0, 0);
    }

    /* Las 4 capturas en fila, hasta 240 px cada una. */
    .apps {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 240px));
      justify-content: center;
      gap: clamp(20px, 2.4vw, 32px);
      margin-top: 28px;
      padding: 8px var(--gutter) 12px;
      overflow: visible;
    }

    .app {
      width: auto;
      max-width: none;
    }

    .app-caption {
      font-size: clamp(1.125rem, 0.5rem + 1vw, 1.375rem);
      text-wrap: balance;
    }
  }
</style>
