---
/**
 * Sección 4: cómo funciona. Única sección teñida de verde (--brand-deep, rejilla y grano).
 * 3 pasos (en escritorio unidos por una línea con un punto que avanza con el scroll) y
 * 3 capturas reales de la app en marcos de móvil hechos en CSS.
 */
import { Image } from 'astro:assets';
import SplitWords from './SplitWords.astro';
import SectionCta from './SectionCta.astro';
import app1 from '../assets/images/app-1.jpg';
import app3 from '../assets/images/app-3.jpg';
import app4 from '../assets/images/app-4.jpg';
import { QUALITY } from '../lib/images';

const steps = [
  {
    n: '01',
    title: 'Valoramos tu caso',
    text: 'Formulario y videollamada para entender qué te pasa.',
  },
  {
    n: '02',
    title: 'Tu plan en el móvil',
    text: 'Ejercicio específico y tus entrenos adaptados, en una app.',
  },
  {
    n: '03',
    title: 'Vuelves al 100 %',
    text: 'Preparamos tu vuelta y te enseño a no recaer.',
  },
];

const shots = [
  { src: app3, alt: 'Captura de la app: registro diario de dolor, estrés y calidad del sueño' },
  {
    src: app1,
    alt: 'Captura de la app de RehabilityWOD: plan de hoy con la sesión y las métricas personales',
  },
  { src: app4, alt: 'Captura de la app: ejercicio con vídeo explicativo y objetivo de la serie' },
];
---

<section
  id="como-funciona"
  class="how section-y tex-grid tex-grain"
  data-theme="dark"
  aria-labelledby="how-title"
>
  <div class="container-x">
    <SplitWords
      id="how-title"
      class="h2-display how-title"
      parts={['Así', { text: 'funciona', accent: true }]}
    />

    <div class="steps-wrap">
      <div class="steps-rail" aria-hidden="true" data-rail>
        <span class="steps-rail-fill" data-rail-fill></span>
        <span class="steps-rail-dot" data-rail-dot></span>
      </div>
      <ol class="steps" role="list">
        {steps.map((step, i) => (
          <li class="step reveal" data-reveal style={`--i:${i}`}>
            <span class="step-num" aria-hidden="true">
              {step.n}
            </span>
            <div class="step-body">
              <h3 class="step-title">
                <span class="sr-only">Paso {i + 1}. </span>
                {step.title}
              </h3>
              <p class="step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <ul
    class="phones"
    role="list"
    aria-label="Capturas reales de la app"
    data-scroll-region
    data-center-scroll
    data-reveal
  >
    {shots.map((shot, i) => (
      <li class="phone" style={`--i:${i}`}>
        <Image
          src={shot.src}
          alt={shot.alt}
          widths={[240, 360, 480, 720]}
          sizes="(min-width: 1024px) 230px, (min-width: 768px) 190px, 40vw"
          quality={QUALITY.webp}
          loading="lazy"
          decoding="async"
          class="phone-img"
        />
      </li>
    ))}
  </ul>

  <div class="container-x">
    <p class="how-note reveal" data-reveal>
      Programas de 8, 12 o 24 semanas. El precio lo vemos en la valoración.
    </p>
    <SectionCta location="how" label="Valorar mi caso" />
  </div>
</section>

<style>
  .how {
    position: relative;
    background: var(--brand-deep);
    color: var(--ink-on-dark);
    text-align: center;
    overflow: hidden;
    --grid-line: rgba(255, 255, 255, 0.04);
    --grain: 0.06;
  }

  /* ---------------- Pasos ---------------- */
  .steps-wrap {
    position: relative;
    margin-top: 20px;
  }

  .steps-rail {
    display: none;
  }

  .steps {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border: 1px solid var(--hair-on-dark);
    border-radius: var(--radius);
    background: rgba(18, 18, 18, 0.6);
    transition:
      transform 0.5s var(--ease),
      border-color 0.5s var(--ease),
      opacity 0.8s var(--ease);
  }

  .step-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 4.5rem; /* 72 px */
    line-height: 0.85;
    letter-spacing: 0.01em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--brand-bright);
    transition: color 0.5s var(--ease);
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 7.7vw, 2rem); /* 30-32 px */
    line-height: 0.9;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  .step-text {
    margin-top: 6px;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--muted-on-dark);
  }

  .step:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .step:hover {
      transform: translateY(-6px);
      border-color: rgba(5, 148, 103, 0.4);
    }

    .step:hover .step-num {
      color: var(--brand-bright);
    }
  }

  /* ---------------- Capturas ---------------- */
  .phones {
    display: flex;
    gap: 12px;
    margin: 14px 0 0;
    padding: 12px calc(50% - 15vw) 12px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .phones::-webkit-scrollbar {
    display: none;
  }

  .phone {
    position: relative;
    flex: none;
    width: 30vw;
    max-width: 190px;
    border: 10px solid var(--void);
    border-radius: 40px;
    background: var(--void);
    box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    scroll-snap-align: center;
    transition: transform 0.9s var(--ease);
  }

  /* Isla superior. */
  .phone::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: 7px;
    left: 50%;
    width: 34%;
    height: 16px;
    border-radius: 999px;
    background: var(--void);
    transform: translateX(-50%);
  }

  .phone :global(.phone-img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 30px;
  }

  /* La central, ligeramente mayor. */
  .phone:nth-child(2) {
    z-index: 1;
    transform: scale(1.06);
  }

  .how-note {
    max-width: 22rem;
    margin: 10px auto 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--muted-on-dark);
  }

  @media (width >= 768px) {
    .phones {
      padding-inline: calc(50% - 95px - 14px - 190px);
    }

    .phone {
      width: 190px;
    }

    .how-note {
      max-width: none;
      margin-top: 28px;
    }
  }

  /* ---------------- Escritorio ---------------- */
  @media (width >= 1024px) {
    .steps-wrap {
      margin-top: 64px;
      padding-top: 36px;
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .step {
      grid-template-columns: 1fr;
      align-items: start;
      align-content: start;
      gap: 22px;
      padding: 32px;
    }

    .step-title {
      font-size: 2rem;
    }

    .step-text {
      margin-top: 10px;
      font-size: 1.0625rem;
    }

    /* Línea horizontal que une los pasos, con un punto que avanza al hacer scroll. */
    .steps-rail {
      position: absolute;
      top: 0;
      left: calc((100% - 48px) / 6);
      right: calc((100% - 48px) / 6);
      display: block;
      height: 1px;
      background: rgba(255, 255, 255, 0.14);
    }

    .steps-rail-fill {
      position: absolute;
      inset: 0;
      background: var(--brand-bright);
      transform-origin: 0 50%;
      transform: scaleX(var(--p, 0));
    }

    .steps-rail-dot {
      position: absolute;
      top: -5px;
      left: -5px;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--brand-bright);
      box-shadow: 0 0 0 5px rgba(52, 211, 153, 0.16);
      transform: translate3d(var(--x, 0px), 0, 0);
    }

    /* Capturas en abanico que se abre al entrar en pantalla. */
    .phones {
      justify-content: center;
      gap: 0;
      margin-top: 72px;
      padding: 24px 0 36px;
      overflow: visible;
    }

    .phone {
      width: 230px;
      max-width: none;
    }

    .phone:nth-child(1) {
      transform: translate3d(28px, 18px, 0) rotate(-6deg);
    }

    .phone:nth-child(2) {
      transform: translate3d(0, -8px, 0);
    }

    .phone:nth-child(3) {
      transform: translate3d(-28px, 18px, 0) rotate(6deg);
    }

    .phones:global(.reveal-armed) .phone:nth-child(1) {
      transform: translate3d(100%, 30px, 0) rotate(0deg);
    }

    .phones:global(.reveal-armed) .phone:nth-child(3) {
      transform: translate3d(-100%, 30px, 0) rotate(0deg);
    }

    .phones:global(.reveal-armed) .phone:nth-child(2) {
      transform: translate3d(0, 30px, 0);
    }

    .phones:global(.reveal-armed.is-in) .phone:nth-child(1) {
      transform: translate3d(28px, 18px, 0) rotate(-6deg);
    }

    .phones:global(.reveal-armed.is-in) .phone:nth-child(2) {
      transform: translate3d(0, -8px, 0);
    }

    .phones:global(.reveal-armed.is-in) .phone:nth-child(3) {
      transform: translate3d(-28px, 18px, 0) rotate(6deg);
    }

    @media (hover: hover) {
      .phones:hover .phone:nth-child(1) {
        transform: translate3d(8px, 14px, 0) rotate(-8deg);
      }

      .phones:hover .phone:nth-child(2) {
        transform: translate3d(0, -18px, 0);
      }

      .phones:hover .phone:nth-child(3) {
        transform: translate3d(-8px, 14px, 0) rotate(8deg);
      }
    }
  }
</style>
