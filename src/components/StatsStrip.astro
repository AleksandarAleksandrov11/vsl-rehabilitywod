---
/**
 * Tira de stats bajo el hero (forma parte de la sección 1).
 * El HTML lleva ya el número final (+120): sin JS o con reduced-motion se ve tal cual.
 */
---

<div class="stats" data-theme="dark">
  <ul class="container-x stats-grid" role="list">
    <li class="stat">
      <span class="stat-num tabular">
        <span class="sr-only">+120</span>
        <span
          aria-hidden="true"
          data-count-to="120"
          data-count-prefix="+"
          data-count-duration="1200"
        >
          +120
        </span>
      </span>
      <span class="stat-label">atletas recuperados</span>
    </li>
    <li class="stat stat-reverse">
      <span class="stat-label">fisio y atleta de CrossFit desde</span>
      <span class="stat-num tabular">2017</span>
    </li>
    <li class="stat">
      <span class="stat-num tabular">100&nbsp;%</span>
      <span class="stat-label">online, estés donde estés</span>
    </li>
    <li class="stat">
      <span class="stat-num">Diario</span>
      <span class="stat-label">seguimiento en app y WhatsApp</span>
    </li>
  </ul>
</div>

<style>
  .stats {
    background: var(--surface);
    border-top: 1px solid var(--hair-on-dark);
    border-bottom: 1px solid var(--hair-on-dark);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 auto;
    padding-block: 8px;
    list-style: none;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 12px 22px 0;
  }

  .stat:nth-child(odd) {
    padding-right: 16px;
  }

  .stat:nth-child(even) {
    padding-left: 16px;
    border-left: 1px solid var(--hair-on-dark);
  }

  .stat:nth-child(n + 3) {
    border-top: 1px solid var(--hair-on-dark);
  }

  .stat-reverse {
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .stat-num {
    font-size: clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem);
    font-weight: 720;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--brand-bright);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--muted-on-dark);
  }

  @media (width >= 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-block: 12px;
    }

    .stat,
    .stat:nth-child(odd),
    .stat:nth-child(even) {
      padding: 28px 24px;
      border-top: 0;
      border-left: 1px solid var(--hair-on-dark);
    }

    .stat:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
