---
/**
 * Sección 3: por qué. Dos bloques con fondos distintos:
 * 3A "¿Te suena?" (claro con rejilla) y 3C comparativa (degradado suave de --brand-soft a
 * --paper). La banda 3B ("El problema no es tu lesión") se quitó a petición del cliente.
 */
import X from '@lucide/astro/icons/x';
import Check from '@lucide/astro/icons/check';
import SplitWords from './SplitWords.astro';
import SectionCta from './SectionCta.astro';

const suena = [
  'Evitas ejercicios que antes hacías sin pensar.',
  'Mejoras, vuelves a entrenar normal y recaes.',
  'Empiezas a pensar que lo tuyo es crónico.',
];

const compare = [
  { old: 'Parar de entrenar', rw: 'Sigues entrenando, con adaptaciones' },
  { old: 'Ejercicios sueltos', rw: 'Plan progresivo para CrossFit' },
  { old: 'Solo cuando duele', rw: 'Seguimiento diario' },
  { old: 'El mismo plan para todos', rw: 'Reajustes cada semana' },
  { old: 'Solo entre sesiones', rw: 'Contacto directo por WhatsApp' },
];
---

<section id="por-que" aria-labelledby="suena-title">
  <!-- 3A -->
  <div class="suena section-y tex-grid" data-theme="light">
    <div class="container-x">
      <SplitWords
        id="suena-title"
        class="h2-display suena-title"
        parts={['¿Te', { text: 'suena?', accent: true }]}
      />
    </div>
    <ul class="suena-list" role="list" aria-label="Situaciones habituales" data-scroll-region>
      {suena.map((text, i) => (
        <li class="suena-card reveal" data-reveal style={`--i:${i}`}>
          <span class="suena-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="suena-text">{text}</p>
        </li>
      ))}
    </ul>
  </div>

  <!-- 3C -->
  <div class="compare section-y" data-theme="light">
    <div class="container-x">
      <SplitWords
        id="compare-title"
        class="h2-display compare-title"
        parts={['Lo de siempre', { br: 'always' }, { text: 'vs RehabilityWOD', accent: true }]}
      />

      <div class="cmp-card" data-reveal>
        <div class="cmp-col cmp-old">
          <h3 class="cmp-head">Lo de siempre</h3>
          <ul class="cmp-list" role="list">
            {compare.map((row, i) => (
              <li class="cmp-row" style={`--i:${i}`}>
                <X size={18} stroke-width={1.75} aria-hidden="true" class="cmp-x" />
                <span class="cmp-strike">{row.old}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="cmp-col cmp-rw" data-theme="dark">
          <h3 class="cmp-head">
            Rehability<span class="accent">WOD</span>
          </h3>
          <ul class="cmp-list" role="list">
            {compare.map((row, i) => (
              <li class="cmp-row" style={`--i:${i + 5}`}>
                <span class="cmp-check" aria-hidden="true">
                  <Check size={14} stroke-width={2.25} />
                </span>
                <span>{row.rw}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <SectionCta location="compare" />
    </div>
  </div>
</section>

<style>
  /* ---------------- 3A ---------------- */
  .suena {
    background: var(--paper);
    color: var(--ink);
    text-align: center;
  }

  .suena-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 16px;
    margin: var(--title-gap) 0 0;
    padding: 6px var(--gutter) 18px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    text-align: left;
  }

  .suena-list::-webkit-scrollbar {
    display: none;
  }

  .suena-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 196px;
    padding: 108px 24px 26px;
    border: 1px solid var(--hair-on-light);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.22);
    scroll-snap-align: start;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease),
      opacity 0.8s var(--ease);
  }

  .suena-num {
    position: absolute;
    top: 10px;
    right: 22px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 6rem; /* 96 px */
    line-height: 0.9;
    color: var(--brand);
    opacity: 0.2;
    transition: opacity 0.5s var(--ease);
  }

  .suena-text {
    position: relative;
    max-width: 15em;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .suena-card:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .suena-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 28px 56px -24px rgba(0, 0, 0, 0.3);
    }

    .suena-card:hover .suena-num {
      opacity: 1;
    }
  }

  @media (width >= 768px) {
    .suena-list {
      grid-auto-columns: calc((100% - 2 * var(--gutter) - 16px) / 2);
    }
  }

  @media (width >= 1024px) {
    .suena-list {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      max-width: calc(1240px + 2 * var(--gutter));
      margin: var(--title-gap) auto 0;
      overflow: visible;
    }

    .suena-card {
      min-height: 240px;
      padding: 32px;
    }
  }

  /* ---------------- 3C ---------------- */
  .compare {
    background: linear-gradient(180deg, var(--brand-soft) 0%, var(--paper) 100%);
    color: var(--ink);
    text-align: center;
  }

  .cmp-card {
    display: grid;
    gap: 12px;
    max-width: 920px;
    margin: var(--title-gap) auto 0;
    text-align: left;
  }

  .cmp-col {
    padding: 24px 22px 18px;
    border-radius: var(--radius);
  }

  .cmp-old {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--hair-on-light);
    color: var(--muted);
  }

  .cmp-rw {
    background: var(--void);
    color: var(--ink-on-dark);
    box-shadow: 0 30px 60px -30px rgba(6, 34, 26, 0.55);
  }

  .cmp-head {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .cmp-old .cmp-head {
    color: var(--muted);
  }

  .cmp-list {
    display: grid;
    gap: 4px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .cmp-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 36px;
    font-size: 1rem;
    line-height: 1.3;
  }

  .cmp-old .cmp-row {
    font-size: 0.9375rem;
    min-height: 32px;
  }

  .cmp-row :global(.cmp-x) {
    flex: none;
    color: #9a9a9a;
  }

  .cmp-strike {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(91, 91, 91, 0.6);
  }

  .cmp-rw .cmp-row {
    font-weight: 500;
  }

  .cmp-check {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--brand);
    color: #ffffff;
  }

  /* Filas escalonadas (60 ms) al entrar en pantalla. */
  .cmp-card:global(.reveal-armed) .cmp-row {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
  }

  .cmp-card:global(.reveal-armed.is-in) .cmp-row {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
    transition-delay: calc(var(--i) * 60ms);
  }

  @media (width >= 768px) {
    .cmp-card {
      grid-template-columns: 1fr 1.08fr;
      align-items: center;
      gap: 0;
    }

    .cmp-col {
      padding: 36px 36px 30px;
    }

    .cmp-old {
      border-radius: var(--radius) 0 0 var(--radius);
      border-right: 0;
    }

    /* La columna de RehabilityWOD, algo más alta y oscura. */
    .cmp-rw {
      padding-block: 52px 46px;
      border-radius: var(--radius);
    }

    .cmp-head {
      font-size: 2rem;
    }

    .cmp-list {
      gap: 6px;
      margin-top: 20px;
    }

    .cmp-row {
      min-height: 44px;
      font-size: 1.0625rem;
    }

    .cmp-old .cmp-row {
      min-height: 44px;
      font-size: 1rem;
    }
  }
</style>
