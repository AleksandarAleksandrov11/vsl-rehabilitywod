---
/**
 * Barra CTA fija abajo en móvil (< 768 px): el botón de valoración y, a su derecha, WhatsApp.
 * Aparece en cuanto el CTA del hero sale de pantalla y se oculta con #valoracion en pantalla.
 * Con el banner de cookies abierto se coloca justo encima (--cb-h, sticky.ts).
 */
import CtaButton from './CtaButton.astro';
import WhatsappButton from './WhatsappButton.astro';
---

<div class="sticky-cta" data-sticky-cta data-theme="dark" aria-hidden="true">
  <CtaButton location="sticky" full tabindex={-1} class="sticky-btn">
    Quiero valorar mi caso
  </CtaButton>
  <WhatsappButton variant="inline" location="sticky" tabindex={-1} />
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 40;
    left: 0;
    right: 0;
    bottom: var(--cb-h, 0px);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px max(16px, env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom))
      max(16px, env(safe-area-inset-left));
    background: rgba(10, 10, 10, 0.88);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--hair-on-dark);
    transform: translate3d(0, 110%, 0);
    visibility: hidden;
    transition:
      transform 0.45s var(--ease),
      visibility 0s linear 0.45s;
  }

  .sticky-cta:global(.is-visible) {
    transform: none;
    visibility: visible;
    transition:
      transform 0.45s var(--ease),
      visibility 0s linear 0s;
  }

  /* Encima del banner: el safe-area inferior ya lo cubre el banner. */
  :global(html[data-cookie-banner='open']) .sticky-cta {
    padding-bottom: 10px;
  }

  /* El CTA cede ancho al botón de WhatsApp. */
  .sticky-cta :global(.sticky-btn) {
    flex: 1;
    min-width: 0;
  }

  @media (width >= 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
