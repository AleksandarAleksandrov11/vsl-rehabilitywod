---
/**
 * Barra CTA fija abajo en móvil (< 768 px): solo el botón, a ancho completo, sin microtexto.
 * Aparece cuando el CTA del hero sale de pantalla, se oculta con #valoracion en pantalla
 * y nunca coincide con el banner de cookies (sticky.ts).
 */
import CtaButton from './CtaButton.astro';
---

<div class="sticky-cta" data-sticky-cta data-theme="dark" aria-hidden="true">
  <CtaButton location="sticky" full tabindex={-1} class="sticky-btn">
    Quiero valorar mi caso
  </CtaButton>
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 40;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 10px max(16px, env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom))
      max(16px, env(safe-area-inset-left));
    background: rgba(10, 10, 10, 0.88);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--hair-on-dark);
    transform: translate3d(0, 110%, 0);
    visibility: hidden;
    transition:
      transform 0.45s var(--ease),
      visibility 0s linear 0.45s;
  }

  .sticky-cta:global(.is-visible) {
    transform: none;
    visibility: visible;
    transition:
      transform 0.45s var(--ease),
      visibility 0s linear 0s;
  }

  @media (width >= 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
