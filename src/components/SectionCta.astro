---
/** CTA de cierre de sección: siempre centrado y sin microtexto. */
import CtaButton from './CtaButton.astro';
import type { CtaLocation } from '../scripts/tracking';

interface Props {
  location: CtaLocation;
  label?: string;
  class?: string;
}

const { location, label, class: className = '' } = Astro.props;
---

<div class:list={['section-cta', 'reveal', className]} data-reveal>
  <CtaButton location={location}>{label ?? 'Quiero valorar mi caso'}</CtaButton>
</div>
