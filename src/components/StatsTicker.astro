---
/**
 * Cinta de stats pegada al borde inferior del hero: 8 datos con icono, sin separadores,
 * en loop hacia la izquierda (40 s). La copia del loop va con aria-hidden e inert.
 * Pausa con hover, con foco y al mantener pulsado (marquee.ts). Con reduced-motion: scroll manual.
 */
import Users from '@lucide/astro/icons/users';
import Dumbbell from '@lucide/astro/icons/dumbbell';
import Activity from '@lucide/astro/icons/activity';
import Smartphone from '@lucide/astro/icons/smartphone';
import MessageCircle from '@lucide/astro/icons/message-circle';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import Video from '@lucide/astro/icons/video';
import CalendarRange from '@lucide/astro/icons/calendar-range';

const items = [
  { Icon: Users, strong: '+120', label: 'atletas recuperados' },
  { Icon: Dumbbell, strong: 'Sin parar', label: 'de entrenar' },
  { Icon: Activity, strong: '+10 años', label: 'en CrossFit' },
  { Icon: Smartphone, strong: '100 %', label: 'online' },
  { Icon: MessageCircle, strong: 'Diario', label: 'seguimiento por app y WhatsApp' },
  { Icon: RefreshCw, strong: 'Cada semana', label: 'reajustes del plan' },
  { Icon: Video, strong: '1 a 1', label: 'videollamadas de seguimiento' },
  { Icon: CalendarRange, strong: '8, 12 o 24', label: 'semanas según tu caso' },
];
const copies = [false, true] as const;
---

<div class="ticker" data-theme="dark">
  <div
    class="marquee ticker-marquee"
    data-marquee
    role="region"
    aria-label="RehabilityWOD en datos"
    tabindex="0"
  >
    <div class="marquee-track ticker-track">
      {copies.map((isCopy) => (
        <ul
          class="marquee-list ticker-list"
          role="list"
          aria-hidden={isCopy ? 'true' : undefined}
          inert={isCopy ? true : undefined}
          data-copy={isCopy ? 'true' : undefined}
        >
          {items.map(({ Icon, strong, label }) => (
            <li class="tk-item">
              <span class="icon-ring" aria-hidden="true">
                <Icon size={22} stroke-width={1.75} />
              </span>
              <span class="tk-text">
                <span class="tk-strong">{strong}</span>
                <span class="tk-label">{label}</span>
              </span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  .ticker {
    position: relative;
    z-index: 2;
    height: 88px;
    background: var(--surface);
    border-top: 1px solid var(--hair-on-dark);
    color: var(--ink-on-dark);
  }

  .ticker-marquee {
    height: 100%;
    --marquee-duration: 40s;
  }

  .ticker-marquee:focus-visible {
    outline-offset: -3px;
    border-radius: 0;
  }

  .ticker-track {
    height: 100%;
  }

  .ticker-list {
    align-items: center;
    gap: 48px;
    height: 100%;
    padding-right: 48px;
  }

  .tk-item {
    flex: none;
    display: flex;
    align-items: center;
    gap: 14px;
    scroll-snap-align: start;
  }

  /* Número o dato grande arriba y la explicación pequeña debajo, a la derecha del icono. */
  .tk-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    white-space: nowrap;
  }

  .tk-strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.875rem; /* 30 px */
    line-height: 1;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--ink-on-dark);
  }

  .tk-label {
    font-size: 0.8125rem;
    line-height: 1.2;
    color: var(--muted-on-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-list {
      padding-inline: var(--gutter);
    }
  }
</style>
