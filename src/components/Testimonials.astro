---
import X from '@lucide/astro/icons/x';
import AboutGerard from './AboutGerard.astro';
import SectionCta from './SectionCta.astro';
import { TESTIMONIALS } from '../data/testimonials';

const copies = [false, true] as const; // la segunda copia es el duplicado del loop
---

<section id="opiniones" class="section-y reviews" data-theme="dark" aria-labelledby="reviews-title">
  <div class="container-x" data-reveal>
    <p class="eyebrow">Opiniones</p>
    <h2 id="reviews-title" class="h2-display mt-4">
      Atletas reales. Vuelta real al&nbsp;box.
    </h2>
  </div>

  <div class="marquee mt-10 md:mt-14" data-marquee>
    <div class="marquee-track">
      {copies.map((isCopy) => (
        <ul
          class="marquee-list"
          role="list"
          aria-hidden={isCopy ? 'true' : undefined}
          inert={isCopy ? true : undefined}
          data-copy={isCopy ? 'true' : undefined}
        >
          {TESTIMONIALS.map((t) => (
            <li class="t-card" data-testimonial={t.id}>
              <span class="t-chip">{t.zona}</span>
              <blockquote class="t-quote">
                <p>«{t.cita}»</p>
              </blockquote>
              <div class="t-foot">
                <div class="t-person">
                  <span class="t-avatar" aria-hidden="true">
                    {t.nombre.charAt(0)}
                  </span>
                  <span class="t-who">
                    <span class="t-name">{t.nombre}</span>
                    <span class="t-desc">{t.descripcion}</span>
                  </span>
                </div>
                <button
                  type="button"
                  class="t-more"
                  data-dialog-open={`t-${t.id}`}
                  aria-haspopup="dialog"
                  tabindex={isCopy ? -1 : undefined}
                >
                  Leer más<span class="sr-only"> de {t.nombre}</span>
                </button>
              </div>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  {TESTIMONIALS.map((t) => (
    <dialog id={`t-${t.id}`} class="t-dialog" aria-labelledby={`t-${t.id}-title`} data-theme="dark">
      <div class="t-dialog-inner">
        <div class="t-dialog-head">
          <span class="t-chip">{t.zona}</span>
          <button type="button" class="t-close" data-dialog-close aria-label="Cerrar opinión">
            <X size={22} stroke-width={1.5} aria-hidden="true" />
          </button>
        </div>
        <h3 id={`t-${t.id}-title`} class="t-dialog-title">
          {t.nombre}
        </h3>
        <p class="t-desc">{t.descripcion}</p>
        <div class="t-dialog-body">
          {t.completo.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </div>
    </dialog>
  ))}

  <div class="container-x">
    <AboutGerard />
    <SectionCta location="testimonials" />
  </div>
</section>

<style>
  .reviews {
    background: var(--void);
    color: var(--ink-on-dark);
    overflow-x: clip;
  }

  /* ---------------- Marquee ---------------- */
  .marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 52s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee:global(.is-paused) .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-list {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 4px 16px 4px 0;
    list-style: none;
  }

  .t-card {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: min(85vw, 340px);
    padding: 24px;
    border: 1px solid var(--hair-on-dark);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .t-chip {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--hair-on-dark);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--brand-bright);
  }

  .t-quote {
    flex: 1;
    margin: 0;
  }

  .t-quote p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-on-dark);
  }

  .t-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--hair-on-dark);
  }

  .t-person {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .t-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-weight: 700;
    font-size: 1rem;
  }

  .t-who {
    display: grid;
    min-width: 0;
  }

  .t-name {
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
  }

  .t-desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--muted-on-dark);
  }

  .t-more {
    flex: none;
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    color: var(--ink-on-dark);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .t-more:hover {
    color: var(--brand-bright);
  }

  @media (width >= 768px) {
    .t-card {
      width: 380px;
    }
  }

  /* Reduced motion: fila con scroll horizontal y snap, sin animación. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: thin;
    }

    .marquee-track {
      animation: none !important;
      transform: none;
      padding-inline: var(--gutter);
    }

    .marquee-list[data-copy] {
      display: none;
    }

    .t-card {
      scroll-snap-align: start;
    }
  }

  /* ---------------- Diálogo "Leer más" ---------------- */
  .t-dialog {
    width: min(640px, calc(100vw - 32px));
    max-height: min(84svh, 760px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--hair-on-dark);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink-on-dark);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .t-dialog::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .t-dialog[open] {
    animation: dialog-in 0.3s var(--ease-out) both;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .t-dialog-inner {
    padding: 20px 24px 28px;
  }

  .t-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .t-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-on-dark);
  }

  .t-close:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .t-dialog-title {
    margin: 12px 0 2px;
    font-size: 1.75rem;
  }

  .t-dialog-body {
    margin-top: 20px;
    display: grid;
    gap: 14px;
  }

  .t-dialog-body p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(245, 245, 242, 0.9);
  }

  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
</style>
