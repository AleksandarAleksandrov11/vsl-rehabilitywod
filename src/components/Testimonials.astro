---
/**
 * Sección 5: opiniones (5A, marquee hacia la izquierda) y quién está detrás (5B).
 * Misma lógica que la cinta de stats: copia con aria-hidden e inert, pausa con hover, foco y
 * pulsación larga, máscara lateral y scroll manual con reduced-motion.
 */
import X from '@lucide/astro/icons/x';
import AboutGerard from './AboutGerard.astro';
import SplitWords from './SplitWords.astro';
import { TESTIMONIALS } from '../data/testimonials';

const copies = [false, true] as const; // la segunda copia es el duplicado del loop
---

<section id="opiniones" aria-labelledby="reviews-title">
  <div class="reviews section-y" data-theme="light">
    <div class="container-x">
      <SplitWords
        id="reviews-title"
        class="h2-display reviews-title"
        parts={[
          'Atletas reales.',
          { br: 'always' },
          { text: 'Vuelta real', accent: true },
          { text: 'al box.', accent: true, nowrap: true },
        ]}
      />
    </div>

    <div class="marquee reviews-marquee" data-marquee>
      <div class="marquee-track">
        {copies.map((isCopy) => (
          <ul
            class="marquee-list reviews-list"
            role="list"
            aria-hidden={isCopy ? 'true' : undefined}
            inert={isCopy ? true : undefined}
            data-copy={isCopy ? 'true' : undefined}
          >
            {TESTIMONIALS.map((t) => (
              <li class="t-card" data-testimonial={t.id}>
                <span class="t-quote-mark" aria-hidden="true">
                  “
                </span>
                <span class="t-chip">{t.zona}</span>
                <blockquote class="t-quote">
                  <p>{t.cita}</p>
                </blockquote>
                <div class="t-foot">
                  <span class="t-avatar" aria-hidden="true">
                    {t.nombre.charAt(0)}
                  </span>
                  <span class="t-who">
                    <span class="t-name">{t.nombre}</span>
                    <span class="t-desc">{t.descripcion}</span>
                  </span>
                  <button
                    type="button"
                    class="t-more"
                    data-dialog-open={`t-${t.id}`}
                    aria-haspopup="dialog"
                    tabindex={isCopy ? -1 : undefined}
                  >
                    Leer más<span class="sr-only"> de {t.nombre}</span>
                  </button>
                </div>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    {TESTIMONIALS.map((t) => (
      <dialog id={`t-${t.id}`} class="t-dialog" aria-labelledby={`t-${t.id}-title`}>
        <div class="t-dialog-inner">
          <div class="t-dialog-head">
            <span class="t-chip">{t.zona}</span>
            <button type="button" class="t-close" data-dialog-close aria-label="Cerrar opinión">
              <X size={22} stroke-width={1.75} aria-hidden="true" />
            </button>
          </div>
          <h3 id={`t-${t.id}-title`} class="t-dialog-title">
            {t.nombre}
          </h3>
          <p class="t-desc">{t.descripcion}</p>
          <div class="t-dialog-body">
            {t.completo.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </div>
      </dialog>
    ))}
  </div>

  <AboutGerard />
</section>

<style>
  .reviews {
    background: var(--paper-2);
    color: var(--ink);
    text-align: center;
    overflow-x: clip;
  }

  .reviews-marquee {
    margin-top: var(--title-gap);
    padding-block: 6px 18px;
    --marquee-duration: 60s;
  }

  .reviews-list {
    gap: 16px;
    padding-right: 16px;
    text-align: left;
  }

  .t-card {
    position: relative;
    flex: none;
    display: flex;
    flex-direction: column;
    width: min(84vw, 360px);
    padding: 28px 28px 24px;
    border: 1px solid var(--hair-on-light);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: 0 16px 36px -26px rgba(0, 0, 0, 0.25);
    scroll-snap-align: center;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .t-quote-mark {
    position: absolute;
    top: 6px;
    right: 22px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 5.5rem;
    line-height: 1;
    color: rgba(5, 148, 103, 0.25);
    pointer-events: none;
  }

  .t-chip {
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .t-quote {
    flex: 1;
    margin: 18px 0 0;
  }

  .t-quote p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .t-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--hair-on-light);
  }

  .t-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1;
  }

  .t-who {
    flex: 1;
    display: grid;
    min-width: 0;
  }

  .t-name {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }

  .t-desc {
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--muted);
  }

  .t-more {
    flex: none;
    min-height: 44px;
    padding: 0 2px;
    border: 0;
    background: none;
    color: var(--brand-strong);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .t-card:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .t-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 30px 56px -26px rgba(0, 0, 0, 0.32);
    }

    /* Se rellena de verde con texto blanco (--brand-strong para mantener el contraste AA). */
    .t-card:hover .t-chip {
      background: var(--brand-strong);
      color: #ffffff;
    }

    .t-more:hover {
      text-decoration-thickness: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-list {
      padding-inline: var(--gutter);
    }
  }

  /* ---------------- Diálogo "Leer más" ---------------- */
  .t-dialog {
    width: min(640px, calc(100vw - 32px));
    max-height: min(84svh, 760px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--hair-on-light);
    border-radius: var(--radius);
    background: #ffffff;
    color: var(--ink);
    overflow: auto;
    overscroll-behavior: contain;
    text-align: left;
  }

  .t-dialog::backdrop {
    background: rgba(10, 10, 10, 0.72);
  }

  .t-dialog[open] {
    animation: fade-up 0.35s var(--ease) both;
  }

  .t-dialog-inner {
    padding: 20px 26px 30px;
  }

  .t-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .t-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
  }

  .t-close:hover {
    background: var(--paper-2);
  }

  .t-dialog-title {
    margin: 14px 0 4px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .t-dialog-body {
    display: grid;
    gap: 14px;
    margin-top: 20px;
  }

  .t-dialog-body p {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #2a2a2a;
  }

  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
</style>
