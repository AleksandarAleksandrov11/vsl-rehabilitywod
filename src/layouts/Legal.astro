---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONFIG } from '../config';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
}

const { title, description, path, heading } = Astro.props;
---

<Base title={title} description={description} path={path}>
  <a href="#main" class="skip-link">
    Saltar al contenido
  </a>
  <Header ctaHref="/#valoracion" />
  <main id="main" class="legal" data-theme="light">
    <article class="container-x legal-inner">
      <p class="eyebrow">Información legal</p>
      <h1 class="legal-title">{heading}</h1>
      <div class="prose">
        <slot />
      </div>
      <p class="legal-updated">Última actualización: {CONFIG.legal.ultimaActualizacion}</p>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    padding-block: calc(var(--header-h) + 56px) 96px;
    background: var(--paper);
    color: var(--ink);
  }

  .legal-inner {
    max-width: calc(68ch + 2 * var(--gutter));
  }

  .legal-title {
    margin: 14px 0 0;
    font-size: clamp(2.25rem, 1.8rem + 2.2vw, 3.5rem);
    font-weight: 740;
  }

  .prose {
    max-width: 68ch;
    margin-top: 32px;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin: 48px 0 12px;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .prose :global(h3) {
    margin: 32px 0 8px;
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 12px 0 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(a) {
    color: var(--brand-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .prose :global(dl) {
    display: grid;
    gap: 2px 20px;
    margin: 16px 0 0;
  }

  .prose :global(dt) {
    font-weight: 600;
  }

  .prose :global(dd) {
    margin: 0 0 10px;
    color: var(--muted);
  }

  .prose :global(.table-wrap) {
    margin-top: 16px;
    overflow-x: auto;
    border: 1px solid var(--hair-on-light);
    border-radius: 14px;
  }

  .prose :global(table) {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hair-on-light);
  }

  .prose :global(th) {
    background: var(--paper-2);
    font-weight: 600;
  }

  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(.prose-button) {
    min-height: 44px;
    padding: 0 18px;
    margin-top: 12px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
  }

  .legal-updated {
    max-width: 68ch;
    margin: 56px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--hair-on-light);
    font-size: 0.9375rem;
    color: var(--muted);
  }

  @media (width >= 640px) {
    .prose :global(dl) {
      grid-template-columns: max-content 1fr;
    }

    .prose :global(dd) {
      margin: 0;
    }
  }
</style>
