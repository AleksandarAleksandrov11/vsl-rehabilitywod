---
import '@fontsource/big-shoulders-display/latin-800';
import '../styles/global.css';
import workSansLatin from '../assets/fonts/work-sans-latin-wght-400-800.woff2?url';
import bigShouldersLatin from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url';
import CookieBanner from '../components/CookieBanner.astro';
import { CONFIG, SEO } from '../config';
import { buildAdScript } from '../lib/ad-script';

interface Props {
  title?: string;
  description?: string;
  /** Ruta canónica, p. ej. "/" o "/privacidad". */
  path?: string;
  noindex?: boolean;
  /** Meta robots explícito (p. ej. "noindex, follow" en las legales). Tiene prioridad sobre noindex. */
  robots?: string;
  /** Solo la home: script en línea que adapta el hero al anuncio (utm_content) sin parpadeo. */
  adScript?: boolean;
  /** Solo la home: manda el PageView a la API de conversiones (boot.ts, data-landing). */
  landing?: boolean;
  /** JSON-LD opcional (solo en la home). */
  jsonLd?: Record<string, unknown>;
}

const {
  title = SEO.title,
  description = SEO.description,
  path = Astro.url.pathname,
  noindex = false,
  robots,
  adScript = false,
  landing = false,
  jsonLd,
} = Astro.props;

// La home con barra final (https://dominio/); el resto sin ella (trailingSlash: 'never').
const canonical =
  path === '/' ? `${CONFIG.siteUrl}/` : `${CONFIG.siteUrl}${path.replace(/\/+$/, '')}`;
const robotsContent =
  robots ?? (noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large');
const ogImage = `${CONFIG.siteUrl}/og.jpg`;
const ogAlt =
  'RehabilityWOD. Recupérate sin dejar de entrenar. Fisioterapia online para atletas de CrossFit.';
---

<!doctype html>
<html lang="es" data-pixel-id={CONFIG.pixelId} data-landing={landing ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {adScript && <script is:inline set:html={buildAdScript()} />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="format-detection" content="telephone=no" />

    <slot name="preload" />
    <link
      rel="preload"
      href={bigShouldersLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="preload" href={workSansLatin} as="font" type="font/woff2" crossorigin="anonymous" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="RehabilityWOD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body id="top">
    <slot />
    <CookieBanner />
    <script>
      import '../scripts/boot';
    </script>
  </body>
</html>
