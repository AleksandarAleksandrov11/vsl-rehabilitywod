---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import VslSection from '../components/VslSection.astro';
import WhySection from '../components/WhySection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Testimonials from '../components/Testimonials.astro';
import ValoracionSection from '../components/ValoracionSection.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { CONFIG, SEO } from '../config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Physiotherapy',
  '@id': `${CONFIG.siteUrl}/#negocio`,
  name: 'RehabilityWOD',
  description: SEO.description,
  url: CONFIG.siteUrl,
  image: `${CONFIG.siteUrl}/og.jpg`,
  email: CONFIG.legal.email,
  telephone: CONFIG.legal.telefonoE164,
  address: {
    '@type': 'PostalAddress',
    addressLocality: CONFIG.legal.ciudad,
    postalCode: CONFIG.legal.codigoPostal,
    addressRegion: 'Tarragona',
    addressCountry: 'ES',
  },
  founder: {
    '@type': 'Person',
    name: 'Gerard Barrantes',
    jobTitle: 'Fisioterapeuta',
  },
  areaServed: 'ES',
  availableLanguage: 'es',
  sameAs: [CONFIG.instagram],
};
---

<Base path="/" jsonLd={jsonLd}>
  <a href="#valoracion" class="skip-link">
    Saltar al formulario
  </a>
  <Header overlay />
  <main id="main">
    <Hero />
    <VslSection />
    <WhySection />
    <HowItWorks />
    <Testimonials />
    <ValoracionSection />
  </main>
  <Footer withStickyGap />
  <StickyCta />
  <script>
    import '../scripts/home';
  </script>
</Base>
