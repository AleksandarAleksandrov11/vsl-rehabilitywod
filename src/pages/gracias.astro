---
/**
 * /gracias: solo para el envío sin JavaScript (con JS, la gracias sale en la tarjeta del
 * formulario). Botón de WhatsApp en la misma pestaña (sin target="_blank") y footer sin CTA.
 * Si no hay número de WhatsApp en src/config.ts, no hay botón.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONFIG, whatsappLink } from '../config';

const waHref = CONFIG.whatsapp
  ? whatsappLink('Hola Gerard, acabo de rellenar el formulario de valoración.')
  : '';
---

<Base
  title="Recibido | RehabilityWOD"
  description="Solicitud de valoración recibida."
  path="/gracias"
  noindex
>
  <a href="#main" class="skip-link">
    Saltar al contenido
  </a>
  <Header ctaHref="/#valoracion" />
  <main id="main" class="thanks" data-theme="dark">
    <div class="container-x thanks-inner">
      <p class="eyebrow">Solicitud recibida</p>
      <h1 class="h1-display thanks-title" data-thanks-title>
        Recibido.
      </h1>
      <p class="thanks-text">
        Te escribo por WhatsApp para agendar la videollamada de valoración. Si prefieres
        adelantarte, escríbeme tú.
      </p>
      <div class="thanks-actions">
        {waHref && (
          <a class="btn btn-primary" href={waHref} data-wa="gracias-boton">
            Escribir por WhatsApp
          </a>
        )}
        <a class="thanks-link" href="/#valoracion">
          Enviar otra solicitud
        </a>
        <a class="thanks-link" href="/#video">
          Volver a ver el vídeo
        </a>
      </div>
    </div>
  </main>
  <Footer cta={false} />
</Base>

<style>
  .thanks {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 64px) 88px;
    background: var(--void);
    color: var(--ink-on-dark);
  }

  .thanks-inner {
    max-width: 760px;
  }

  .thanks-title {
    margin: 16px 0 0;
    overflow-wrap: anywhere;
  }

  .thanks-text {
    max-width: 34rem;
    margin: 24px 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(245, 245, 242, 0.86);
  }

  .thanks-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    margin-top: 36px;
  }

  .thanks-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    color: var(--ink-on-dark);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (width >= 640px) {
    .thanks-actions {
      flex-direction: row;
      align-items: center;
      gap: 24px;
    }
  }
</style>

<script>
  import { trackEvent } from '../scripts/tracking';

  // Solo si alguien llega aquí con JS activo (p. ej., el formulario se envió sin que cargara form.ts).
  trackEvent('lead_thankyou_view');
</script>
